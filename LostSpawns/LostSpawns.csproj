<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
		<ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
		<!-- Not compression needed -->
		<CompressionEnabled>false</CompressionEnabled>
		<!-- Required: ILGPU uses IL reflection for kernel compilation -->
		<PublishTrimmed>false</PublishTrimmed>
		<RunAOTCompilation>false</RunAOTCompilation>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.3" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.3" PrivateAssets="all" />
	</ItemGroup>

	<!-- SpawnDev libraries from local feed / nuget.org (was ProjectReference; flipped on 2026-04-25 -->
	<!-- so GitHub Actions / GitHub Pages can build the project without local sources). -->
	<ItemGroup>
		<PackageReference Include="SpawnDev.SpawnJS" Version="3.0.4" />
		<PackageReference Include="SpawnDev.SpawnJS.Blazor" Version="3.0.4" />
		<PackageReference Include="SpawnDev.SpawnJS.Cryptography" Version="2.1.1" />
		<PackageReference Include="SpawnDev.GameUI" Version="1.1.1-local.5" />
		<PackageReference Include="SpawnDev.VoxelEngine" Version="0.2.0-rc.5-local.17" />
	</ItemGroup>

	<ItemGroup>
		<ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
	</ItemGroup>

</Project>
