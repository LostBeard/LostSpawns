<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
		<ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
		<!-- Not compression needed -->
		<CompressionEnabled>false</CompressionEnabled>
		<!-- Required: ILGPU uses IL reflection for kernel compilation -->
		<PublishTrimmed>false</PublishTrimmed>
		<RunAOTCompilation>false</RunAOTCompilation>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.3" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.3" PrivateAssets="all" />
	</ItemGroup>

	<!-- SpawnDev.GameUI - GPU-rendered game UI overlay -->
	<ItemGroup>
		<ProjectReference Include="..\..\..\SpawnDev.GameUI\SpawnDev.GameUI\SpawnDev.GameUI\SpawnDev.GameUI.csproj" />
		<ProjectReference Include="..\..\..\SpawnDev.VoxelEngine\SpawnDev.VoxelEngine\SpawnDev.VoxelEngine\SpawnDev.VoxelEngine.csproj" />
	</ItemGroup>

	<ItemGroup>
		<ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
	</ItemGroup>

</Project>
