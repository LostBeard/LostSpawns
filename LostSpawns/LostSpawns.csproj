<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
		<ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
		<!-- Not compression needed -->
		<CompressionEnabled>false</CompressionEnabled>
		<!-- AOT BY DEFAULT (found on TJ's Quest 2026-10-16): interpreted, the game's own code (world, entities, light, the headset frame) kept the main thread 95% busy and
		     frames came every 24-28 ms with the GPU idle half the time. Compiled it is several times faster. WasmStripILAfterAOT=false keeps the IL that ILGPU compiles
		     kernels from; WasmDedup=false makes the build parallel (minutes, not an hour; same speed, a bigger dotnet.native.wasm). WASM AOT needs trimming; the app and the
		     libraries that reach their code by reflection are rooted below. For a fast build use -p:LostSpawnsAot=false. -->
		<LostSpawnsAot Condition="'$(LostSpawnsAot)' == ''">true</LostSpawnsAot>
		<RunAOTCompilation>$(LostSpawnsAot)</RunAOTCompilation>
		<WasmStripILAfterAOT>false</WasmStripILAfterAOT>
		<WasmDedup>false</WasmDedup>
		<PublishTrimmed>$(LostSpawnsAot)</PublishTrimmed>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.3" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.3" PrivateAssets="all" />
	</ItemGroup>

	<!-- SpawnDev libraries from local feed / nuget.org (was ProjectReference; flipped on 2026-04-25 -->
	<!-- so GitHub Actions / GitHub Pages can build the project without local sources). -->
	<ItemGroup>
		<PackageReference Include="SpawnDev.SpawnJS" Version="3.0.4" />
		<PackageReference Include="SpawnDev.SpawnJS.Blazor" Version="3.0.4" />
		<PackageReference Include="SpawnDev.SpawnJS.Cryptography" Version="2.1.1" />
		<PackageReference Include="SpawnDev.GameUI" Version="1.1.1-local.5" />
		<PackageReference Include="SpawnDev.VoxelEngine" Version="0.2.0-rc.5-local.19" />
	</ItemGroup>

	<!-- Kept whole by the trimmer: ILGPU reads IL and reflects in its static constructors; the app serialises its own types with System.Text.Json; the engine and the UI are reached through delegates and kernels -->
	<ItemGroup>
		<TrimmerRootAssembly Include="ILGPU" />
		<TrimmerRootAssembly Include="ILGPU.Algorithms" />
		<TrimmerRootAssembly Include="SpawnDev.ILGPU" />
		<TrimmerRootAssembly Include="SpawnDev.VoxelEngine" />
		<TrimmerRootAssembly Include="SpawnDev.GameUI" />
		<TrimmerRootAssembly Include="LostSpawns" />
	</ItemGroup>

	<ItemGroup>
		<ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
	</ItemGroup>

</Project>
