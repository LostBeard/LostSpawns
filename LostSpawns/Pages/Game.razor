    private void HandleAchievement(string name)
    {
        Hud.NotifyAchievement(name + "! (+25 XP)");
        Audio.PlayLevelUp();
        Stats.AwardXp(25);
        // Golden screen flash to add weight to the milestone moment -
        // toast + audio alone can be missed in a busy fight, the flash
        // makes it impossible to miss. Shorter than dawn (1.2s) since
        // achievements happen mid-action.
        Hud.ScreenOverlay.Flash(
            System.Drawing.Color.FromArgb(90, 240, 200, 80), 0.7f);
        // Gold-mote celebration burst at the player's feet so the moment
        // also has a visible particle component the player can see in
        // their world view, not just the screen-edge flash.
        var feet = new System.Numerics.Vector3(
            Renderer.Camera.Position.X,
            Renderer.Camera.Position.Y - 1.5f,
            Renderer.Camera.Position.Z);
        Hud.ShowGoldBurst(feet, 12);
        // Immediate save on achievement so progress isn't lost to a browser
        // crash between 10s auto-saves. Achievements are rare + high-value
        // so the cost of one extra localStorage write is negligible.
        Save.SaveNow(Renderer.Camera.Position, Renderer.Camera.Yaw, Renderer.Camera.Pitch);
    }

    private void HandleLevelUpSound(int newLevel)
    {
        Audio.PlayLevelUp();
        // Level-up celebratory overlay: green flash announces the new tier
        // without blocking the screen. Matches the dawn-flash pattern so
        // victory moments all feel the same. Also fully restores stamina
        // + heals 20% HP - the "second wind" buff for hitting a milestone.
        Hud.ScreenOverlay.Flash(System.Drawing.Color.FromArgb(110, 100, 220, 120), 0.8f);
        // Gold-mote burst rises from the player's feet on level-up - same
        // celebration motif used for achievements. Larger count (16) since
        // level-ups are bigger moments than individual achievements.
        var lvFeet = new System.Numerics.Vector3(
            Renderer.Camera.Position.X,
            Renderer.Camera.Position.Y - 1.5f,
            Renderer.Camera.Position.Z);
        Hud.ShowGoldBurst(lvFeet, 16);
        Stats.Stamina = 1f;
        Stats.Heal(0.20f);
        // Level-up second wind also closes any active bleed - the rush of
        // adrenaline + the symbolic "fresh chapter" reads as a complete
        // reset moment. Matches the existing stamina + HP restore.
        if (Stats.BleedSecondsRemaining > 0)
        {
            Stats.ClearBleed();
            Hud.NotifySuccess("Bleeding stopped");
        }
        Hud.NotifyAchievement($"Level {newLevel}");
        // Unlock toasts: surface recipes that just became craftable at this
        // level. Scans CraftingService for RequiredLevel == newLevel so
        // players know exactly what progression this tier earned them.
        foreach (var recipe in Crafter.Recipes)
        {
            if (recipe.RequiredLevel == newLevel)
                Hud.NotifySuccess($"Unlocked: {recipe.DisplayName}");
        }
    }

