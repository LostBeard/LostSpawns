@page "/game"
@using SpawnDev.BlazorJS.JSObjects
@using LostSpawns.Models
@using LostSpawns.Rendering
@inject VoxelEngineService Engine
@inject InputService Input
@inject RenderService Renderer
@inject WorldService World
@inject SettingsService Settings
@inject HudService Hud
@inject PlayerStatsService Stats
@inject WorldTimeService Time
@inject InventoryService Inventory
@inject SpawnDev.BlazorJS.BlazorJSRuntime JS
@inject NavigationManager Nav
@implements IAsyncDisposable

<PageTitle>Lost Spawns — Game</PageTitle>

@if (!_ready)
{
    <div class="game-loading">
        <div class="game-loading-inner">
            <h2 class="glow-text">INITIALIZING</h2>
            <p class="text-dim">@_status</p>
        </div>
    </div>
}

<div class="game-container">
    <canvas id="gameCanvas" @ref="_canvasRef" width="1280" height="720"
            tabindex="0" @onclick="OnCanvasClick"></canvas>
</div>

@code {
    private ElementReference _canvasRef;
    private bool _ready;
    private string _status = "";
    private string _fpsText = "";
    private int _frameCount;
    private double _fpsTimer;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        _status = "Creating GPU context…";
        StateHasChanged();

        await Engine.InitAsync();

        _status = "Building render pipeline…";
        StateHasChanged();

        using var canvas = new HTMLCanvasElement(_canvasRef);
        Renderer.Init(canvas, Engine.Accelerator!, World);

        _status = "Loading terrain data…";
        StateHasChanged();

        // Load real-world Deer Isle heightmap
        var heightmapLoader = new LostSpawns.Services.HeightmapLoader();
        try
        {
            await heightmapLoader.LoadAsync(JS, "maps/deer_isle.heightmap");
            heightmapLoader.SetCellSize(15.62f); // 16km / 1024 grid
            World.InitWithHeightmap(heightmapLoader, seed: 42);
            _status = "Deer Isle terrain loaded!";
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Game] Heightmap load failed: {ex.Message}, falling back to procedural");
            World.Init(seed: 42);
        }
        StateHasChanged();

        // Camera above terrain - spawn on the island, not in the ocean
        int spawnHeight = World.GetHeightAt(0, 0);
        // If spawn is underwater, find higher ground nearby
        if (spawnHeight <= 64) // 64 = sea level in HeightmapLoader
        {
            for (int search = 1; search < 200; search += 4)
            {
                int h = World.GetHeightAt(search * 16, search * 16);
                if (h > 68) { spawnHeight = h; break; }
            }
        }
        Renderer.Camera.Position = new System.Numerics.Vector3(0, spawnHeight + 8, 0);
        Renderer.Camera.Yaw = 45f;
        Renderer.Camera.Pitch = -15f;

        // Initialize GPU-rendered HUD overlay FIRST so the loading screen can render
        // on top of the canvas while GenerateChunksAsync chews through the initial radius.
        // Previously the player saw a black canvas for ~15s with no feedback.
        Hud.Init(Renderer, _canvasRef);

        Input.Attach();
        Input.OnEscapePressed += HandleEscape;
        Input.OnPointerLockChanged += HandlePointerLockChanged;
        Input.OnInventoryTogglePressed += HandleInventoryToggle;
        Input.OnInteractPressed += HandleInteract;
        Input.OnDebugDamagePressed += HandleDebugDamage;
        Input.OnDebugHealPressed += HandleDebugHeal;
        Hud.OnResumeClicked += HandleResumeClicked;
        Hud.OnQuitToMenuClicked += HandleQuitToMenuClicked;

        Renderer.OnUpdate = OnGameUpdate;

        // Swap the HTML "INITIALIZING" splash for the canvas + GameUI loading overlay.
        _ready = true;
        _status = "";
        StateHasChanged();

        // Start RAF so the loading overlay animates while we await chunk generation.
        // OnGameUpdate short-circuits to Hud.Update-only while Hud.IsLoading, so the
        // camera + input feed doesn't run yet.
        Hud.ShowLoadingScreen();
        Renderer.StartRenderLoop();

        // Initial chunks - small radius for fast startup (streaming fills the rest).
        // Awaited here; OnGameUpdate drives the progress bar from World.LoadedSections.
        const int InitialRadius = 4;
        _initialLoadExpectedColumns = CountColumnsInRadius(InitialRadius);
        var initialCount = await World.GenerateChunksAsync(
            Renderer.Camera.Position, InitialRadius);

        Console.WriteLine($"[Game] Loaded {initialCount} columns, {World.LoadedSections} sections");

        // Queue remaining chunks — GPU kernel generates heightmaps async
        World.UpdateDesiredChunks(Renderer.Camera.Position, Settings.DrawDistance);

        Hud.HideLoadingScreen();
    }

    private int _initialLoadExpectedColumns = 49; // radius 4 circle fallback

    private static int CountColumnsInRadius(int radius)
    {
        int r2 = radius * radius;
        int count = 0;
        for (int dx = -radius; dx <= radius; dx++)
        for (int dz = -radius; dz <= radius; dz++)
            if (dx * dx + dz * dz <= r2) count++;
        return count;
    }

    private void HandleEscape()
    {
        // Priority unwinds the screen stack one at a time, top first: settings
        // overlay (pushed from pause menu) -> inventory -> pause. Loading ignores
        // Escape entirely because stacking another modal over it would orphan the
        // loading screen (HideLoadingScreen only pops when loading is on top).
        if (Hud.IsLoading) return;
        if (Hud.IsSettingsOpen)  { Hud.HideSettings();  return; }
        if (Hud.IsInventoryOpen) { Hud.HideInventory(); return; }
        if (Hud.IsPaused) HandleResumeClicked();
        else Hud.ShowPauseMenu();
    }

    private void HandleInventoryToggle()
    {
        // Don't let inventory open on top of another modal - loading, pause, and
        // settings all own the screen and should not be pushed over. If the
        // inventory itself is already up, the toggle closes it (handled inside
        // Hud.ToggleInventory).
        if (Hud.IsInventoryOpen) { Hud.ToggleInventory(); return; }
        if (Hud.IsLoading || Hud.IsPaused || Hud.IsSettingsOpen) return;
        Hud.ToggleInventory();
    }

    // Dev keybinds for testing the damage/heal UX. Remove once real combat /
    // consumption sources replace them.
    private void HandleDebugDamage() => Stats.TakeDamage(0.1f);
    private void HandleDebugHeal()   => Stats.Heal(0.1f);

    private void HandleInteract()
    {
        // Interaction is locked behind active gameplay - pause / inventory / loading
        // all short-circuit via IsAnyMenuOpen so accidentally chopping through a menu
        // doesn't happen.
        if (Hud.IsAnyMenuOpen) return;

        var origin = Renderer.Camera.Position;
        var dir = Renderer.Camera.Front;
        var hit = World.Raycast(origin, dir, maxDistance: 5f);
        if (!hit.DidHit) return;

        var brokenType = World.TryBreakBlock(hit.BlockX, hit.BlockY, hit.BlockZ);
        if (brokenType == LostSpawns.Models.BlockType.Air) return;

        var drop = DropForBlockType(brokenType);
        if (drop is null)
        {
            Hud.Notify($"Broke {brokenType}");
            return;
        }

        bool added = Inventory.TryAdd(drop);
        if (added) Hud.NotifySuccess($"+1 {drop.Name}");
        else Hud.NotifyWarning($"Inventory full - {drop.Name} dropped");
    }

    private static LostSpawns.Services.InventoryItem? DropForBlockType(LostSpawns.Models.BlockType t) => t switch
    {
        LostSpawns.Models.BlockType.Wood   => new("material.wood",   "Wood",   1, LostSpawns.Services.ItemCategory.Material),
        LostSpawns.Models.BlockType.Leaves => new("material.leaves", "Leaves", 1, LostSpawns.Services.ItemCategory.Material),
        LostSpawns.Models.BlockType.Stone  => new("material.stone",  "Stone",  1, LostSpawns.Services.ItemCategory.Material),
        LostSpawns.Models.BlockType.Dirt   => new("material.dirt",   "Dirt",   1, LostSpawns.Services.ItemCategory.Material),
        LostSpawns.Models.BlockType.Grass  => new("material.dirt",   "Dirt",   1, LostSpawns.Services.ItemCategory.Material),
        LostSpawns.Models.BlockType.Sand   => new("material.sand",   "Sand",   1, LostSpawns.Services.ItemCategory.Material),
        _ => null,
    };

    private void HandlePointerLockChanged(bool locked)
    {
        // Lock lost while playing => show pause menu (covers alt-tab, browser Escape, etc.)
        if (!locked && !Hud.IsPaused)
            Hud.ShowPauseMenu();
    }

    private void HandleResumeClicked()
    {
        Hud.HidePauseMenu();
        try
        {
            using var canvas = new HTMLCanvasElement(_canvasRef);
            canvas.RequestPointerLock();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Game] Pointer lock request on resume failed: {ex.Message}");
        }
    }

    private void HandleQuitToMenuClicked()
    {
        Nav.NavigateTo("/");
    }

    private void OnGameUpdate(float deltaTime)
    {
        // During initial terrain load: drive the loading progress bar from
        // WorldService.LoadedColumns, skip all gameplay input. Same short-circuit
        // path as other modals so the camera doesn't drift while waiting.
        if (Hud.IsLoading)
        {
            Input.ConsumeMouseDelta();
            int loaded = World.LoadedColumns;
            int expected = Math.Max(loaded, _initialLoadExpectedColumns);
            float fraction = expected > 0 ? (float)loaded / expected : 0f;
            Hud.SetLoadingProgress(fraction, $"{loaded} / {expected} chunks");
            Hud.Update(deltaTime, Renderer.Camera.Position, Renderer.Camera.Yaw);
            return;
        }

        // While any menu is open: don't feed camera movement, mouse look, or FPS
        // counter updates. Chunk streaming + HUD input still run so the menu stays
        // interactive. Drain mouse deltas so resuming doesn't snap the view.
        if (Hud.IsAnyMenuOpen)
        {
            Input.ConsumeMouseDelta();
            Hud.Update(deltaTime, Renderer.Camera.Position, Renderer.Camera.Yaw);
            return;
        }

        // Sprint gate: holding Shift + actually moving + having stamina above the
        // cutoff. 0.05 threshold prevents frame-by-frame flicker around zero.
        bool movingKey =
            Input.KeysDown.Contains("KeyW") || Input.KeysDown.Contains("KeyS") ||
            Input.KeysDown.Contains("KeyA") || Input.KeysDown.Contains("KeyD");
        bool shiftHeld =
            Input.KeysDown.Contains("ShiftLeft") || Input.KeysDown.Contains("ShiftRight");
        bool sprinting = shiftHeld && movingKey && Stats.Stamina > 0.05f;

        // Gameplay simulation: time advances, survival stats decay, etc. Paused /
        // inventory / settings / loading all short-circuit above this point so the
        // world clock (and hunger/thirst) literally stop while menus are up.
        // Temperature target comes from WorldTimeService so nights feel cold and
        // days warm; future clothing system can modulate this before passing in.
        Time.Tick(deltaTime);
        Stats.Tick(deltaTime, Time.TargetTemperature, sprinting);

        // Camera sees the sprint gate too so we can't sprint-speed when stamina is
        // empty even if Shift is still held.
        Renderer.Camera.ProcessKeyboard(Input.KeysDown, deltaTime, allowSprint: sprinting);

        var (dx, dy) = Input.ConsumeMouseDelta();
        if (dx != 0 || dy != 0)
            Renderer.Camera.ProcessMouseMovement((float)dx, (float)dy);

        // Crosshair turns target-colored when a block is within E-press reach.
        // Same 5m range as HandleInteract uses so the visual matches actual ability.
        var targetHit = World.Raycast(Renderer.Camera.Position, Renderer.Camera.Front, 5f);
        Hud.Crosshair.IsTargeting = targetHit.DidHit;

        // Update desired chunks (dispatches GPU tasks, unloads distant chunks + their GPU buffers)
        World.UpdateDesiredChunks(Renderer.Camera.Position, Settings.DrawDistance);

        // Dequeue GPU-ready chunks into the active dictionary (RenderService reads directly)
        World.ProcessReadyChunks(16);

        // Update GPU-rendered HUD (compass bearing, minimap position, animations)
        Hud.Update(deltaTime, Renderer.Camera.Position, Renderer.Camera.Yaw);

        // FPS counter (still needed for debug overlay data)
        _frameCount++;
        _fpsTimer += deltaTime;
        if (_fpsTimer >= 1.0)
        {
            _fpsText = $"{_frameCount} FPS";
            _frameCount = 0;
            _fpsTimer = 0;
        }
    }

    private void OnCanvasClick()
    {
        if (Input.IsPointerLocked) return;
        try
        {
            using var canvas = new HTMLCanvasElement(_canvasRef);
            canvas.RequestPointerLock();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Game] Pointer lock failed: {ex.Message}");
        }
    }

    public ValueTask DisposeAsync()
    {
        Input.OnEscapePressed -= HandleEscape;
        Input.OnPointerLockChanged -= HandlePointerLockChanged;
        Input.OnInventoryTogglePressed -= HandleInventoryToggle;
        Input.OnInteractPressed -= HandleInteract;
        Input.OnDebugDamagePressed -= HandleDebugDamage;
        Input.OnDebugHealPressed -= HandleDebugHeal;
        Hud.OnResumeClicked -= HandleResumeClicked;
        Hud.OnQuitToMenuClicked -= HandleQuitToMenuClicked;

        Renderer.StopRenderLoop();
        Hud.Dispose();
        Renderer.Dispose();
        World.Reset();
        Input.Detach();
        return ValueTask.CompletedTask;
    }
}

<style>
    .game-container {
        position: fixed;
        inset: 0;
        z-index: 300;
        background: #000;
    }

    .game-container canvas {
        display: block;
        width: 100%;
        height: 100%;
        cursor: crosshair;
        outline: none;
    }

    .game-loading {
        position: fixed;
        inset: 0;
        z-index: 300;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--bg-deep);
        text-align: center;
    }
    .game-loading-inner h2 {
        font-size: 1.5rem;
        letter-spacing: 0.15em;
        margin-bottom: 0.5rem;
    }

    /* HUD is now GPU-rendered by SpawnDev.GameUI - no HTML overlays needed */
</style>
