    private void HandleQuickSave()
    {
        if (Hud.IsLoading || Hud.IsDead) return;
        Save.SaveNow(Renderer.Camera.Position, Renderer.Camera.Yaw, Renderer.Camera.Pitch);
        Hud.LastSaveTime = Save.LastSaveTime;
        Hud.NotifySuccess("Quick-saved");
    }

    private void HandleQuickDrink()
    {
        if (Hud.IsAnyMenuOpen) return;
        if (Hud.IsLoading || Hud.IsDead) return;
        // Search hotbar then backpack for the first consume.water and use
        // it. Stew also hydrates so it's a fallback for runs that already
        // drank their water bottles dry.
        string[] priority = new[] { "consume.water", "craft.stew" };
        foreach (var id in priority)
        {
            for (int i = 0; i < LostSpawns.Services.InventoryService.HotbarSize; i++)
            {
                if (Inventory.Hotbar[i]?.Id == id
                    && Inventory.TryUseSlot(fromHotbar: true, index: i)) return;
            }
            for (int i = 0; i < LostSpawns.Services.InventoryService.BackpackSize; i++)
            {
                if (Inventory.Backpack[i]?.Id == id
                    && Inventory.TryUseSlot(fromHotbar: false, index: i)) return;
            }
        }
        Hud.NotifyWarning("No water to drink");
    }

    private void HandleQuickHeal()
    {
        if (Hud.IsAnyMenuOpen) return;
        if (Hud.IsLoading || Hud.IsDead) return;
        // Single id today (med.bandage) - both Bandage and Field Bandage
        // craft into the same item. If the consumable list grows (med.salve,
        // etc) extend this priority array the same way HandleQuickEat does.
        const string bandageId = "med.bandage";
        for (int i = 0; i < LostSpawns.Services.InventoryService.HotbarSize; i++)
        {
            if (Inventory.Hotbar[i]?.Id == bandageId
                && Inventory.TryUseSlot(fromHotbar: true, index: i)) return;
        }
        for (int i = 0; i < LostSpawns.Services.InventoryService.BackpackSize; i++)
        {
            if (Inventory.Backpack[i]?.Id == bandageId
                && Inventory.TryUseSlot(fromHotbar: false, index: i)) return;
        }
        Hud.NotifyWarning("No bandage to use");
    }

    private void HandleQuickEat()
    {
        if (Hud.IsAnyMenuOpen) return;
        if (Hud.IsLoading || Hud.IsDead) return;
        // Priority order: cooked meats first (best hunger + positive HP),
        // then raw meats, then beans. Pick the first match found by
        // scanning hotbar then backpack. Uses TryUseSlot to route through
        // the normal consume event (toast / audio / bleed-clear hooks).
        string[] priority = new[]
        {
            "food.deer_meat_cooked", "food.boar_meat_cooked", "food.rabbit_meat_cooked",
            "craft.stew",
            "food.deer_meat", "food.boar_meat", "food.rabbit_meat",
            "consume.beans",
        };
        foreach (var id in priority)
        {
            for (int i = 0; i < LostSpawns.Services.InventoryService.HotbarSize; i++)
            {
                var item = Inventory.Hotbar[i];
                if (item?.Id == id)
                {
                    if (Inventory.TryUseSlot(fromHotbar: true, index: i)) return;
                }
            }
            for (int i = 0; i < LostSpawns.Services.InventoryService.BackpackSize; i++)
            {
                var item = Inventory.Backpack[i];
                if (item?.Id == id)
                {
                    if (Inventory.TryUseSlot(fromHotbar: false, index: i)) return;
                }
            }
        }
        Hud.NotifyWarning("No food to eat");
    }

    private void HandleDropActive()
    {
        if (Hud.IsAnyMenuOpen) return;
        var item = Inventory.ActiveItem;
        if (item is null) return;

        // Drop one unit of the active stack at the player's feet plus a
        // forward nudge so the player walks past it before pickup auto-fires.
        var fwd = Renderer.Camera.Front;
        var pos = new System.Numerics.Vector3(
            Renderer.Camera.Position.X + fwd.X * 1.5f,
            Renderer.Camera.Position.Y - 1.0f,
            Renderer.Camera.Position.Z + fwd.Z * 1.5f);
        var dropped = item with { Count = 1 };
        Ground.Drop(pos, dropped);

        // Decrement the active slot.
        int slot = Inventory.ActiveHotbarIndex;
        if (item.Count > 1)
            Inventory.SetHotbar(slot, item with { Count = item.Count - 1 });
        else
            Inventory.SetHotbar(slot, null);

        Hud.Notify($"Dropped {item.Name}");
    }

    private float _preMuteVolume = 1f;
    private bool _muted;
    private void HandleMuteToggle()
    {
        if (_muted)
        {
            Audio.MasterVolume = _preMuteVolume;
            Settings.SaveVolume(_preMuteVolume);
            Hud.Notify("Audio unmuted");
            _muted = false;
        }
        else
        {
            _preMuteVolume = Settings.MasterVolume;
