    /// <summary>Sum the Count of every slot holding the given item id.</summary>
    private int CountInventory(string id)
    {
        int total = 0;
        for (int i = 0; i < LostSpawns.Services.InventoryService.HotbarSize; i++)
            if (Inventory.Hotbar[i]?.Id == id) total += Inventory.Hotbar[i]!.Count;
        for (int i = 0; i < LostSpawns.Services.InventoryService.BackpackSize; i++)
            if (Inventory.Backpack[i]?.Id == id) total += Inventory.Backpack[i]!.Count;
        return total;
    }

    /// <summary>
    /// True if any entity currently charging the player is within range.
    /// Used to gate stamina regen - fleeing rabbits don't count, a
    /// boar / wolf bearing down on you does.
    /// </summary>
    private bool IsHostileNearby(System.Numerics.Vector3 pos, float range)
    {
        float r2 = range * range;
        foreach (var e in Wildlife.Entities)
        {
            if (e.Alert != LostSpawns.Services.AlertMode.Charge) continue;
            float dx = pos.X - e.Position.X;
            float dz = pos.Z - e.Position.Z;
            if (dx * dx + dz * dz <= r2) return true;
        }
        return false;
    }

    private void HandleSleep()
    {
        if (Hud.IsAnyMenuOpen) return;
        var fire = Fires.FindNearest(Renderer.Camera.Position);
        if (fire is null) { Hud.NotifyWarning("Need a campfire to sleep"); return; }
        if (fire.Fuel <= 0.05f) { Hud.NotifyWarning("Fire is out"); return; }
        // Can't nod off while you're actively bleeding out. Bandage first.
        // This forces the player to keep at least one bandage/leaves stash
        // handy after a wolf fight if they want to time-skip.
        if (Stats.BleedSecondsRemaining > 0)
        {
            Hud.NotifyWarning("Can't sleep while bleeding - press H to bandage");
            return;
        }
        // Starving / dehydrated bodies can't actually sleep - your body
        // wakes you up. Realism + adds a fail-state where the player
        // must eat/drink before camping.
        if (Stats.Hunger < 0.10f)
        {
            Hud.NotifyWarning("Too hungry to sleep - eat something");
            return;
        }
        if (Stats.Thirst < 0.10f)
        {
            Hud.NotifyWarning("Too thirsty to sleep - find water");
            return;
        }

        // Advance time to early dawn. If we're already past dawn this
        // rolls the clock forward a full cycle which is fine - the player
        // gets a fresh day regardless.
        const float Dawn = 0.05f;
        Time.SetDayFraction(Dawn);

        // Passing hours decay: drop hunger / thirst by ~1/6 of max (8 hours
        // at ~2%/hour). Matches the gameplay tick's rough rate.
        Stats.Hunger = MathF.Max(0, Stats.Hunger - 0.15f);
        Stats.Thirst = MathF.Max(0, Stats.Thirst - 0.15f);

        // Rest restores stamina fully and gives a small HP bump. Warmth
        // bumps to comfortable since the player slept by an active fire -
        // wake up cozy, not freezing. Bigger fires (bonfire radius 12)
        // give a deeper rest: extra HP heal + warmer wakeup. Reads as
        // "warmer fire = better night's sleep".
        Stats.Stamina = 1f;
        bool bonfireRest = fire.Radius >= 10f;
        Stats.Heal(bonfireRest ? 0.30f : 0.15f);
        Stats.Temperature = MathF.Max(Stats.Temperature, bonfireRest ? 0.65f : 0.55f);
        if (bonfireRest) Hud.Notify("Bonfire rest - deeper recovery");

        // Black fade for the time skip so the transition doesn't jump-cut.
        // ScreenOverlay flash uses the same lifetime model as damage / heal
        // flashes but with a long duration + full-alpha black.
        Hud.ScreenOverlay.Flash(System.Drawing.Color.FromArgb(240, 0, 0, 0), 1.2f);
        Hud.NotifySuccess("Slept through the night");
        // Small gold-mote burst to mark the rejuvenation moment - reads
        // as the body's energy returning. 6 motes is a softer celebration
        // than a level-up (16) but still feels rewarding.
        var sleepFeet = new System.Numerics.Vector3(
            Renderer.Camera.Position.X,
            Renderer.Camera.Position.Y - 1.5f,
            Renderer.Camera.Position.Z);
        Hud.ShowGoldBurst(sleepFeet, 6);
        Stats.TryAwardAchievement("First Sleep");
        // Well-rested XP: rewards players who actually camp the night out
        // rather than sprinting through darkness.
        Stats.AwardXp(10);
    }

    private static LostSpawns.Services.InventoryItem? DropForBlockType(LostSpawns.Models.BlockType t) => t switch
    {
        LostSpawns.Models.BlockType.Wood   => new("material.wood",   "Wood",   1, LostSpawns.Services.ItemCategory.Material),
        LostSpawns.Models.BlockType.Leaves => new("material.leaves", "Leaves", 1, LostSpawns.Services.ItemCategory.Material),
        LostSpawns.Models.BlockType.Stone  => new("material.stone",  "Stone",  1, LostSpawns.Services.ItemCategory.Material),
        LostSpawns.Models.BlockType.Dirt   => new("material.dirt",   "Dirt",   1, LostSpawns.Services.ItemCategory.Material),
        LostSpawns.Models.BlockType.Grass  => new("material.dirt",   "Dirt",   1, LostSpawns.Services.ItemCategory.Material),
        LostSpawns.Models.BlockType.Sand   => new("material.sand",   "Sand",   1, LostSpawns.Services.ItemCategory.Material),
        _ => null,
    };

    private static LostSpawns.Models.BlockType? BlockTypeForItemId(string id) => id switch
    {
        "material.wood"   => LostSpawns.Models.BlockType.Wood,
        "material.stone"  => LostSpawns.Models.BlockType.Stone,
        "material.dirt"   => LostSpawns.Models.BlockType.Dirt,
        "material.sand"   => LostSpawns.Models.BlockType.Sand,
        "material.leaves" => LostSpawns.Models.BlockType.Leaves,
        _ => null,
    };

    private void HandlePlaceBlock()
    {
        if (Hud.IsAnyMenuOpen) return;
        if (!BlockActionReady()) return;

        // Terraform mode: RMB builds a sphere of stone at the aim point.
        // Skips the held-item check entirely - we're building from "the
        // earth itself," not consuming inventory items (matches NMS where
        // build-mode pulls from a unified terrain resource).
        if (_terraformMode)
        {
            var thit = World.Raycast(Renderer.Camera.Position, Renderer.Camera.Front, 8f);
            if (!thit.DidHit) return;
            ExecuteTerraform(thit, carve: false);
            return;
        }

        var item = Inventory.ActiveItem;
        if (item is null) return;

        // Placeable world objects (campfires) are a separate path - they
        // spawn in the CampfireService instead of modifying voxel data. Block
        // placement falls through if the active item isn't a placeable.
        if (item.Id == "place.campfire")
        {
            HandlePlaceCampfire(item);
            return;
        }
        if (item.Id == "place.bonfire")
        {
            HandlePlaceBonfire(item);
            return;
        }
        if (item.Id == "craft.torch")
        {
            HandlePlaceTorch(item);
            return;
        }
        if (item.Id == "tool.bow")
        {
            HandleShootBow(item);
            return;
        }

        var blockType = BlockTypeForItemId(item.Id);
        if (blockType is null) return; // active slot isn't a placeable material

        var hit = World.Raycast(Renderer.Camera.Position, Renderer.Camera.Front, 5f);
        if (!hit.DidHit) return;

        bool placed = World.TryPlaceBlock(hit.AdjacentX, hit.AdjacentY, hit.AdjacentZ, blockType.Value);
        if (!placed) return;

        ConsumeBlockActionCost();
        // Place audio: tool-family sound (chop for wood/leaves, mine for
        // stone, generic thud otherwise). Different from chop because the
        // PlayBeep frequency is lower for the "thunk" feel.
        Audio.PlayBeep(blockType.Value == LostSpawns.Models.BlockType.Stone ? 90f : 140f,
                       0.10f, 0.18f, "square");
        // Tiny dust puff at the placed block's center - 3 particles for a
        // satisfying "thunk" cue paired with the audio. Smaller than break
        // since you're depositing material, not shattering it.
        Hud.ShowDustPuff(new System.Numerics.Vector3(
            hit.AdjacentX + 0.5f, hit.AdjacentY + 0.5f, hit.AdjacentZ + 0.5f), 3);

        // Decrement active hotbar slot. Clearing at 0 leaves the slot empty so the
        // player can't keep placing out of thin air.
        int slot = Inventory.ActiveHotbarIndex;
        if (item.Count > 1)
            Inventory.SetHotbar(slot, item with { Count = item.Count - 1 });
        else
            Inventory.SetHotbar(slot, null);

        Hud.NotifySuccess($"Placed {item.Name}");
    }

    private void HandlePlaceCampfire(LostSpawns.Services.InventoryItem item)
    {
        var hit = World.Raycast(Renderer.Camera.Position, Renderer.Camera.Front, 5f);
        if (!hit.DidHit)
        {
            Hud.NotifyWarning("Aim at the ground to place a campfire");
            return;
        }

        // Spawn the fire ONE BLOCK ABOVE the targeted cell so it sits on top
        // of the surface rather than intersecting. AdjacentX/Y/Z is the empty
        // cell we'd place a block into, which is already ground+1.
        var pos = new System.Numerics.Vector3(hit.AdjacentX + 0.5f, hit.AdjacentY, hit.AdjacentZ + 0.5f);
        Fires.Spawn(pos);
        ConsumeBlockActionCost();

        // Consume one campfire from the slot.
        int slot = Inventory.ActiveHotbarIndex;
        if (item.Count > 1)
            Inventory.SetHotbar(slot, item with { Count = item.Count - 1 });
        else
            Inventory.SetHotbar(slot, null);

        Hud.NotifySuccess("Placed Campfire");
        Stats.TryAwardAchievement("First Fire");
    }

    private void HandlePlaceBonfire(LostSpawns.Services.InventoryItem item)
    {
        var hit = World.Raycast(Renderer.Camera.Position, Renderer.Camera.Front, 5f);
        if (!hit.DidHit)
        {
            Hud.NotifyWarning("Aim at the ground to place a bonfire");
            return;
        }
        var pos = new System.Numerics.Vector3(hit.AdjacentX + 0.5f, hit.AdjacentY, hit.AdjacentZ + 0.5f);
        // Bonfire = bigger campfire: 12-block radius (vs 6) + boosted
        // intensity. Reuses Campfire data path so all the existing
        // smoke/glow/cook/feed flows just work.
        var bonfire = Fires.Spawn(pos, radius: 12f);
        bonfire.Intensity = 2.0f;
        bonfire.Fuel = 1.0f;
        ConsumeBlockActionCost();

        int slot = Inventory.ActiveHotbarIndex;
        if (item.Count > 1)
            Inventory.SetHotbar(slot, item with { Count = item.Count - 1 });
        else
            Inventory.SetHotbar(slot, null);

        Hud.NotifySuccess("Placed Bonfire (2x range)");
        Stats.TryAwardAchievement("First Fire");
    }

    private void HandleShootBow(LostSpawns.Services.InventoryItem bow)
    {
        // Need at least one feather-arrow in inventory. Consume one per shot.
        if (!Inventory.HasItem("material.feather"))
        {
            Hud.NotifyWarning("Need feathers for arrows");
            return;
        }
        if (!BlockActionReady()) return;

        // Longer range + tighter cone than melee swing. Bow aims like a
        // scoped weapon - you have to line up the shot but the hit carries
        // more damage (0.7 vs 0.55 axe, drops rabbit in one shot).
        var origin = Renderer.Camera.Position;
        var dir = Renderer.Camera.Front;
        var target = Wildlife.FindTargetInCone(origin, dir, maxDist: 20f, minDot: 0.99f);

        // Always consume an arrow + charge the cooldown, even on a miss -
        // you loosed it, it's gone. Bow string also wears per shot (regardless
        // of hit), matching how real archery wears the string.
        Inventory.TryConsumeOne("material.feather");
        ConsumeBlockActionCost();
        DegradeActiveToolWithFeedback();
        // Bow release is a smaller wrist motion than a club swing - 1.5deg
        // pitch kick rather than the default 2.5. Keeps the next aim shot
        // feeling tight even after a string release.
        ApplyCameraKick(1.5f);
        Audio.PlayBowShot();

        if (target is not null)
        {
            // Sneak shot: 2x damage on an unaware target. Bow is the
            // precision weapon, so a clean ambush arrow should be
            // devastating - drops most prey in one shot, halves a wolf
            // or boar's HP from full.
            bool sneakingNow = Input.KeysDown.Contains("ControlLeft") || Input.KeysDown.Contains("ControlRight");
            float arrowDmg = 0.7f;
            if (sneakingNow && target.Alert == LostSpawns.Services.AlertMode.Idle)
            {
                arrowDmg *= 2f;
                Hud.NotifySuccess("Sneak shot!");
            }
            bool killed = Wildlife.ApplyDamage(target, arrowDmg, origin);
            Audio.PlayHit();
            Hud.ShowImpactMark(target.Position);
            Hud.ShowDamageNumber(target.Position, arrowDmg);
            // Per-shot DegradeActiveToolWithFeedback already fired above so
            // the bow wears whether you hit or miss. No duplicate degrade
            // here - real archery the string stresses on every release.
            // Any bow-kill lands the Bowman achievement, not only the first
            // attempt - so a miss-then-hit sequence on the same shot still
            // counts.
            if (killed) Stats.TryAwardAchievement("Bowman");
        }
    }

    private void HandlePlaceTorch(LostSpawns.Services.InventoryItem item)
    {
        var hit = World.Raycast(Renderer.Camera.Position, Renderer.Camera.Front, 5f);
        if (!hit.DidHit)
        {
            Hud.NotifyWarning("Aim at the ground to place a torch");
            return;
        }

        // Torches are tiny campfires: smaller warmth radius, low intensity,
        // but they burn for a long time - a placed-and-forgotten light
        // source. Reuses the campfire pipeline so rendering + cooking + feed
        // all just work (though a torch is too small to cook meaningfully).
        var pos = new System.Numerics.Vector3(hit.AdjacentX + 0.5f, hit.AdjacentY, hit.AdjacentZ + 0.5f);
        var torch = Fires.Spawn(pos, radius: 2.5f);
        torch.Intensity = 0.5f;
        ConsumeBlockActionCost();

        int slot = Inventory.ActiveHotbarIndex;
        if (item.Count > 1)
            Inventory.SetHotbar(slot, item with { Count = item.Count - 1 });
        else
            Inventory.SetHotbar(slot, null);

        Hud.NotifySuccess("Placed Torch");
    }

    private void HandlePointerLockChanged(bool locked)
    {
        // Lock lost while playing => show pause menu (covers alt-tab, browser Escape, etc.)
        if (!locked && !Hud.IsPaused)
            Hud.ShowPauseMenu();
    }

    private void HandleResumeClicked()
    {
        Hud.HidePauseMenu();
        try
        {
            using var canvas = new HTMLCanvasElement(_canvasRef);
            canvas.RequestPointerLock();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Game] Pointer lock request on resume failed: {ex.Message}");
        }
    }

    private void HandleQuitToMenuClicked()
    {
        Nav.NavigateTo("/");
    }

    private void HandleDied()
    {
        // Dramatic red splash + push the death screen. Pointer lock exit is the
        // browser's default when the player's mouse moves on the new screen, so
        // we nudge it by dispatching a JS exit via the canvas API. Simpler: rely
        // on the player's first mouse move during death screen to release lock.
        Hud.ScreenOverlay.Flash(System.Drawing.Color.FromArgb(180, 180, 20, 20), 0.8f);
        Hud.NotifyDamage("You died");
        // Camera collapse: pitch the view downward toward the ground as the
        // player "falls". Mouse-look snapback restores it on respawn click;
        // until then it's a strong "you're on the floor" read.
        Renderer.Camera.Pitch = Math.Clamp(Renderer.Camera.Pitch - 70f, -89f, 89f);
        // Record the death FIRST so the death screen reads the up-to-date
        // LongestLifeSeconds (which RecordDeath snapshots from CurrentLife
        // before zeroing). Otherwise the just-finished run never shows on
        // its own death screen.
        Stats.RecordDeath();
        Hud.ShowDeathScreen();
        Audio.PlayDeath();
    }

    private void HandleRespawnClicked()
    {
        // Quick black fade to cover the teleport + reset while the player's
        // view snaps back to spawn. Runs off the existing flash lifetime so
        // no extra state needed.
        Hud.ScreenOverlay.Flash(System.Drawing.Color.FromArgb(230, 0, 0, 0), 0.8f);
        Stats.ResetToDefaults();
        Hud.HideDeathScreen();
        // 30-second resurrection grace: HP regen multiplier doubles so the
        // player can outpace any minor damage their first minute back. Decays
        // in OnGameUpdate via _resurrectGraceTimer.
        _resurrectGraceTimer = 30f;
        Hud.NotifySuccess("Resurrection grace - faster healing for 30s");
        // Death breaks the kill chain - no carrying combos across lives.
        _killStreak = 0;
        _killStreakExpiry = DateTime.MinValue;
        // Re-arm the new-record ding for the next life. Once-per-life
        // gate prevents spam if the player crosses then dies then resp's.
        _newRecordPinged = false;

        // Teleport camera back to the heightmap spawn point and re-arm gravity so
        // it settles cleanly on the terrain. Reset pitch so the death-collapse
        // tilt doesn't leak into the new life.
        int spawnHeight = World.GetHeightAt(0, 0);
        Renderer.Camera.Position = new System.Numerics.Vector3(0, spawnHeight + EyeHeight + 2f, 0);
        Renderer.Camera.Pitch = -15f;
        _verticalVelocity = 0;
        _peakFallSpeed = 0;
        _grounded = false;
        // Arrival dust burst at the spawn spot - reads as the player
        // materializing back in the world. Slightly bigger than a fall
        // landing because it's a "you arrived" moment.
        Hud.ShowDustPuff(new System.Numerics.Vector3(0, spawnHeight + 0.5f, 0), 10);

        // Respawn cleanup: abandon uncollected ground loot (it's gone with the
        // body) and reset the wandering entity population. Campfires are
        // deliberately preserved since they represent player investment - a
        // chopped-down tree is still chopped down, a lit fire still lit.
        Ground.Items.Clear();
        Wildlife.Entities.Clear();
        Wildlife.SpawnStarter(Renderer.Camera.Position, World);

        // Respawn-mercy: if every campfire went out before the player died,
        // re-spawn a low-fuel starter fire near spawn so the new life isn't
        // immediately fighting hypothermia + zero shelter at night.
        bool hasLiveFire = false;
        foreach (var f in Fires.Fires)
            if (f.Fuel > 0.05f) { hasLiveFire = true; break; }
        if (!hasLiveFire)
        {
            var fireXZ = new System.Numerics.Vector3(3, 0, 0);
            int fireY = World.GetHeightAt(Renderer.Camera.Position.X + fireXZ.X,
                                          Renderer.Camera.Position.Z + fireXZ.Z) + 1;
            var mercyFire = Fires.Spawn(new System.Numerics.Vector3(
                Renderer.Camera.Position.X + fireXZ.X,
                fireY,
                Renderer.Camera.Position.Z + fireXZ.Z));
            mercyFire.Fuel = 0.4f; // half-fuel - feed it to keep it
            Hud.NotifySuccess("Respawn fire lit - feed it Wood to keep going");
        }

        // Re-request pointer lock so the player can look around immediately.
        try
        {
            using var canvas = new HTMLCanvasElement(_canvasRef);
            canvas.RequestPointerLock();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Game] Pointer lock on respawn failed: {ex.Message}");
        }
    }

    private void OnGameUpdate(float deltaTime)
    {
        // During initial terrain load: drive the loading progress bar from
        // WorldService.LoadedColumns, skip all gameplay input. Same short-circuit
        // path as other modals so the camera doesn't drift while waiting.
        if (Hud.IsLoading)
        {
            Input.ConsumeMouseDelta();
            int loaded = World.LoadedColumns;
            int expected = Math.Max(loaded, _initialLoadExpectedColumns);
            float fraction = expected > 0 ? (float)loaded / expected : 0f;
            Hud.SetLoadingProgress(fraction, $"{loaded} / {expected} chunks");
            Hud.Update(deltaTime, Renderer.Camera.Position, Renderer.Camera.Yaw);
            return;
        }

        // While any menu is open: don't feed camera movement, mouse look, or FPS
        // counter updates. Chunk streaming + HUD input still run so the menu stays
        // interactive. Drain mouse deltas so resuming doesn't snap the view.
        if (Hud.IsAnyMenuOpen)
        {
            Input.ConsumeMouseDelta();
            Hud.Update(deltaTime, Renderer.Camera.Position, Renderer.Camera.Yaw);
            return;
        }

        // Sprint gate: holding Shift + actually moving + having stamina above the
        // cutoff. 0.05 threshold prevents frame-by-frame flicker around zero.
        bool movingKey =
            Input.KeysDown.Contains("KeyW") || Input.KeysDown.Contains("KeyS") ||
            Input.KeysDown.Contains("KeyA") || Input.KeysDown.Contains("KeyD");
        bool shiftHeld =
            Input.KeysDown.Contains("ShiftLeft") || Input.KeysDown.Contains("ShiftRight");
        // Sprint requires stamina AND not bleeding - a wound drops the
        // player's stride. Pairs with the bleed-blocks-sleep rule so the
        // punishment for ignoring a wolf bite has real movement cost.
        bool sprinting = shiftHeld && movingKey && Stats.Stamina > 0.05f
                         && Stats.BleedSecondsRemaining <= 0;

        // Gameplay simulation: time advances, survival stats decay, etc. Paused /
        // inventory / settings / loading all short-circuit above this point so the
        // world clock (and hunger/thirst) literally stop while menus are up.
        // Temperature target comes from WorldTimeService so nights feel cold and
        // days warm; future clothing system can modulate this before passing in.
        Time.Tick(deltaTime);
        Weather.Tick(deltaTime);
        Audio.UpdateRainAmbient(Weather.RainIntensity);
        // Danger drone: ramp up when any hostile is charging within ~20
        // blocks. Multiple chargers stack the intensity. Bears count
        // double since they're the apex threat.
        float dangerIntensity = 0f;
        foreach (var ent in Wildlife.Entities)
        {
            if (ent.Alert != LostSpawns.Services.AlertMode.Charge) continue;
            float ddx = ent.Position.X - Renderer.Camera.Position.X;
            float ddz = ent.Position.Z - Renderer.Camera.Position.Z;
            if (ddx * ddx + ddz * ddz > 20f * 20f) continue;
            dangerIntensity += ent.Kind == LostSpawns.Services.EntityKind.Bear ? 2f : 1f;
        }
        float dangerNorm = MathF.Min(dangerIntensity / 3f, 1f);
        Audio.UpdateDangerDrone(dangerNorm);
        // Push the same normalized intensity to the HUD so the red edge
        // vignette tracks the audio drone in lockstep.
        Hud.DangerIntensity = dangerNorm;

        // Pack warning: 3+ wolves charging within range = real trouble.
        // Toast fires once with a 30s cooldown so we don't spam during
        // a sustained pack fight. Re-arms when the pack falls below 3.
        int chargingWolves = 0;
        foreach (var ent in Wildlife.Entities)
        {
            if (ent.Alert != LostSpawns.Services.AlertMode.Charge) continue;
            if (ent.Kind != LostSpawns.Services.EntityKind.Wolf) continue;
            float wdx = ent.Position.X - Renderer.Camera.Position.X;
            float wdz = ent.Position.Z - Renderer.Camera.Position.Z;
            if (wdx * wdx + wdz * wdz <= 25f * 25f) chargingWolves++;
        }
        if (chargingWolves >= 3 && _packWarningArmed
            && (DateTime.UtcNow - _lastPackWarn).TotalSeconds >= 30)
        {
            Hud.NotifyDamage($"Pack closing! {chargingWolves} wolves");
            _lastPackWarn = DateTime.UtcNow;
            _packWarningArmed = false;
        }
        else if (chargingWolves < 3)
        {
            _packWarningArmed = true;
        }

        // New-record celebration: fires once per life when CurrentLife
        // first exceeds the previous LongestLife. Two-beep ding + toast.
        // Skip if there's no previous record (first run shouldn't ding).
        if (!_newRecordPinged
            && Stats.LongestLifeSeconds > 1f
            && Stats.CurrentLifeSeconds > Stats.LongestLifeSeconds)
        {
            _newRecordPinged = true;
            Audio.PlayBeep(880, 0.10f, 0.18f);
            Audio.PlayBeep(1320, 0.14f, 0.18f);
            Hud.NotifySuccess("New best run!");
        }
        // Heavy chargers (Bear, Boar) kick up dust trails as they run.
        // Random chance per frame per entity keeps the look organic
        // without flooding the particle buffer. ~25% per frame at 60fps
        // means ~15 dust spawns per charging bear per second - enough
        // to read as a continuous trail without drowning out other FX.
        foreach (var ent in Wildlife.Entities)
        {
            if (ent.Alert != LostSpawns.Services.AlertMode.Charge) continue;
            if (ent.Kind != LostSpawns.Services.EntityKind.Bear
                && ent.Kind != LostSpawns.Services.EntityKind.Boar) continue;
            if (_dustTrailRng.NextDouble() > 0.25) continue;
            Hud.ShowDustPuff(new System.Numerics.Vector3(
                ent.Position.X, ent.Position.Y - 0.4f, ent.Position.Z), 2);
        }
        TickThunderQueue(deltaTime);

        // Rainwater collection: while it's actively raining hard, fill a
        // bottle every 90s and slot it into inventory. The body catches
        // what falls. No-op when rain is light / dry or inventory is full.
        if (Weather.RainIntensity > 0.5f)
        {
            _rainCollectTimer += deltaTime;
            if (_rainCollectTimer >= 90f)
            {
                _rainCollectTimer = 0;
                var bottle = new LostSpawns.Services.InventoryItem(
                    "consume.water", "Water", 1, LostSpawns.Services.ItemCategory.Drink);
                if (Inventory.TryAdd(bottle))
                    Hud.NotifySuccess("+1 Water (rainwater)");
            }
        }
        else
        {
            _rainCollectTimer = 0;
        }

        // Forage respawn: every 60s of active play, if total ground items
        // are below 6, drop one new mushroom/berry in the player's
        // walking radius. World feels foraged-from-nature instead of
        // a one-shot starter.
        _forageRespawnTimer += deltaTime;
        if (_forageRespawnTimer >= 60f)
        {
            _forageRespawnTimer = 0;
            if (Ground.Items.Count < 6)
            {
                float angle = (float)(_forageRng.NextDouble() * Math.PI * 2);
                float dist = 10f + (float)_forageRng.NextDouble() * 20f;
                float fx = Renderer.Camera.Position.X + MathF.Cos(angle) * dist;
                float fz = Renderer.Camera.Position.Z + MathF.Sin(angle) * dist;
                int fy = World.GetHeightAt(fx, fz) + 1;
                bool isMushroom = _forageRng.NextDouble() < 0.5;
                var item = isMushroom
                    ? new LostSpawns.Services.InventoryItem("food.mushroom", "Mushroom", 1, LostSpawns.Services.ItemCategory.Food)
                    : new LostSpawns.Services.InventoryItem("food.berry",    "Berries",  1, LostSpawns.Services.ItemCategory.Food);
                Ground.Drop(new System.Numerics.Vector3(fx, fy, fz), item);
            }
        }
        // Wind ambient: a baseline 0.3 intensity always runs so the world
        // never feels sonically dead, plus rain adds on top so storms howl.
        // Pitch bias by day phase: -1 deep night (low cold whoosh) to +1
        // midday (bright high whistle). Cosine maps DayFraction so pitch
        // smoothly sweeps once per day cycle.
        float windPitch = -MathF.Cos(Time.DayFraction * MathF.PI * 2f);
        Audio.UpdateWindAmbient(0.3f + Weather.RainIntensity * 0.6f, deltaTime, windPitch);

        // Low-HP heartbeat. Interval shortens as HP drops so the pulse
        // accelerates the closer the player gets to dying. Gate at 0.35 so
        // the sound doesn't fire at "normal" damage levels.
        if (Stats.Health < 0.35f && !Stats.IsDead)
        {
            _heartbeatTimer -= deltaTime;
            if (_heartbeatTimer <= 0f)
            {
                Audio.PlayHeartbeat();
                // Subtle red pulse synced with the heartbeat audio - reads
                // as "your vision is throbbing with each beat" while the
                // persistent low-HP vignette stays in the background.
                Hud.ScreenOverlay.Flash(
                    System.Drawing.Color.FromArgb(35, 200, 30, 30), 0.35f);
                // 0.0 HP -> 0.45s interval; 0.35 HP -> 1.1s interval.
                float norm = Stats.Health / 0.35f; // 1 at threshold, 0 at death
                _heartbeatTimer = 0.45f + norm * 0.65f;
            }
        }
        else
        {
            _heartbeatTimer = 0f;
        }

        // Out-of-breath gasp. Fires once immediately on the crossing into
        // low stamina (<15%) and repeats every ~2.5s while still below.
        // Clears the latch as soon as the player's past 25% so they don't
        // retrigger on tiny bounces.
        bool staminaLow = Stats.Stamina < 0.15f && !Stats.IsDead;
        if (staminaLow)
        {
            if (!_wasStaminaLow)
            {
                Audio.PlayGasp();
                _gaspTimer = 2.5f;
                _wasStaminaLow = true;
            }
            else
            {
                _gaspTimer -= deltaTime;
                if (_gaspTimer <= 0f)
                {
                    Audio.PlayGasp();
                    _gaspTimer = 2.5f;
                }
            }
        }
        else if (Stats.Stamina > 0.25f)
        {
            // First time we cross above the recovery threshold after a low
            // bout, fire a brief "caught my breath" sigh - inverted-pitch
            // version of the gasp so the player's ear marks the recovery.
            if (_wasStaminaLow)
            {
                Audio.PlayBeep(180f, 0.20f, 0.08f, "triangle");
            }
            _wasStaminaLow = false;
            _gaspTimer = 0f;
        }

        // Cricket chirps at night - jittered ~1-3s interval so the ambient
        // doesn't sound like a clock. Only chirps when it's dark so the day
        // phase stays silent of insects.
        if (Time.IsNight)
        {
            _cricketTimer -= deltaTime;
            if (_cricketTimer <= 0f)
            {
                Audio.PlayCricket();
                // Cadence faster at deep night (DayFraction near 0.8) and
                // slower at the dusk/dawn edges. Reads as "the night is
                // alive at peak" instead of a flat chirp interval.
                // Distance from peak night (0.80). Closer = shorter interval.
                float cricketDist = MathF.Abs(Time.DayFraction - 0.80f);
                float jitterScale = 1.0f + cricketDist * 4f;     // 1x at midnight, 1.8x at edges
                _cricketTimer = jitterScale * (0.8f + (float)_cricketRng.NextDouble() * 1.6f);
            }

            // Distant wolf howls at sparse random intervals. Purely
            // atmospheric - doesn't spawn a wolf, just announces that they're
            // out there. 15-45s between howls so the night doesn't feel on a
            // loop. Daytime silences this so the world doesn't howl at noon.
            _distantHowlTimer -= deltaTime;
            if (_distantHowlTimer <= 0f)
            {
                Audio.PlayWolfHowl();
                // Brief desaturated-blue flash on the distant howl so the
                // tension lands visually too. Short fade keeps it ambient
                // rather than a damage tell.
                Hud.ScreenOverlay.Flash(
                    System.Drawing.Color.FromArgb(50, 60, 100, 180), 1.4f);
                _distantHowlTimer = 15f + (float)_howlRng.NextDouble() * 30f;
            }

            // Owl hoots during deep night (0.72-0.88 day fraction). Longer
            // interval than the wolf howl so the two ambients don't step on
            // each other.
            float frac = Time.DayFraction;
            if (frac >= 0.72f && frac <= 0.88f)
            {
                _owlTimer -= deltaTime;
                if (_owlTimer <= 0f)
                {
                    Audio.PlayOwlHoot();
                    _owlTimer = 20f + (float)_owlRng.NextDouble() * 35f;
                }
            }
        }
        else
        {
            _cricketTimer = 0f;
            // Rearm the howl timer on first night-tick so dawn doesn't cue a
            // stale howl. A small first-howl delay gives the player a quiet
            // moment to notice dusk before the first cry.
            _distantHowlTimer = 8f + (float)_howlRng.NextDouble() * 12f;

            // Dawn bird chirps fire during the sunrise window. Short 2-6s
            // jittered interval makes it feel like a whole flock is active.
            float dawnFrac = Time.DayFraction;
            if (dawnFrac >= 0.06f && dawnFrac <= 0.18f)
            {
                _birdTimer -= deltaTime;
                if (_birdTimer <= 0f)
                {
                    Audio.PlayBirdChirp();
                    _birdTimer = 2f + (float)_birdRng.NextDouble() * 4f;
                }
            }
        }

        // Fire crackle: fires when the player is in a campfire's warmth
        // radius. Interval is jittered so the pops don't lock onto a clock
        // and feel alive - real fires don't tick on a metronome.
        if (Fires.GetWarmthBonusAt(Renderer.Camera.Position) > 0)
        {
            _crackleTimer -= deltaTime;
            if (_crackleTimer <= 0f)
            {
                Audio.PlayFireCrackle();
                _crackleTimer = 0.6f + (float)_crackleRng.NextDouble() * 1.4f;
            }
        }
        else
        {
            _crackleTimer = 0f;
        }
        // Rain shifts temperature target colder (wet + wind = chill). Clothing
        // system will eventually scale this, but for now rain always bites.
        // Campfire warmth bonus is additive on top - stand next to the fire
        // during a cold rain and the bonus can fully cancel the chill.
        float warmthBonus = Fires.GetWarmthBonusAt(Renderer.Camera.Position);
        // Fur Coat, if crafted + held, gives a flat +0.15 warmth anywhere.
        // Passive for MVP (no equipment slot system yet) - just having one
        // in inventory is enough to notice the temperature track.
        float coatBonus = Inventory.HasItem("gear.fur_coat") ? 0.15f : 0f;
        // Held torch grants a small warmth bonus on top - actively holding
        // a flame in your hand should help on a cold night, even if you
        // haven't placed it yet. Smaller than a coat (0.08 vs 0.15) so the
        // coat is still the better long-term gear choice.
        float torchBonus = Inventory.ActiveItem?.Id == "craft.torch" ? 0.08f : 0f;
        // Clamp to [0.05, 0.85] so stacking fire + coat + noon sun doesn't
        // drive the player into heatstroke range, and an unfueled night
        // can't collapse the ambient below the bottom of the temp track.
        float ambient = Math.Clamp(
            Time.TargetTemperature
                - Weather.RainIntensity * 0.1f
                + warmthBonus
                + coatBonus
                + torchBonus,
            0.05f, 0.85f);
        // Camping = faster recovery. Multiplier scales with warmth so a
        // barely-in-range fire helps less than one the player is practically
        // sitting in, but still beats out-in-the-cold. Resurrection grace
        // window stacks on top so a player who just respawned heals fast
        // even before they make it to a fire.
        float regenMul = warmthBonus > 0 ? 1f + warmthBonus * 3f : 1f;
        if (_resurrectGraceTimer > 0)
        {
            _resurrectGraceTimer -= deltaTime;
            regenMul += 1.0f;
        }
        Stats.HealthRegenMultiplier = regenMul;

        // Stamina regen pauses while a hostile is within 6 blocks and
        // charging - can't catch your breath with a wolf running you down.
        Stats.StaminaRegenBlocked = IsHostileNearby(Renderer.Camera.Position, 6f);

        Stats.Tick(deltaTime, ambient, sprinting);
        // Wildlife wanders each frame; gated by the same active-play branch so
        // critters hold still while the player is paused / in menus.
        // Push the current survival day number so EntityService can scale the
        // wolf bias + entity cap. Cheap assignment; computed EffectiveCap
        // refers to it each tick.
        Wildlife.DayNumber = Time.DayNumber;
        // Fire-as-deterrent: halve wolf sensing range while player is inside a
        // campfire's warmth aura. Sneak-crouch stacks on top: holding Ctrl
        // further halves the aggro range so a player can creep past idle
        // wolves at 2.5 blocks even before they auto-detect.
        float aggro = Fires.GetWarmthBonusAt(Renderer.Camera.Position) > 0.01f ? 5f : 10f;
        bool sneaking = Input.KeysDown.Contains("ControlLeft") || Input.KeysDown.Contains("ControlRight");
        if (sneaking) aggro *= 0.5f;
        Wildlife.WolfAggroRange = aggro;
        // Bears use their own range (15 default). Sneak halves it the same
        // way wolves get halved, so a creeping player can slip past a bear
        // at ~7.5 blocks. Campfire warmth has no bearing on bear sense -
        // bears don't care about the fire the way wolves do.
        Wildlife.BearAggroRange = sneaking ? 7.5f : 15f;
        Hud.IsSneaking = sneaking;

        // Terraform brush preview + paint-stroke continuous fire. While
        // B-mode is on, raycast the surface under the crosshair every
        // frame for the dotted-sphere preview, then check held mouse
        // buttons - LMB-held = continuous carve, RMB-held = continuous
        // build, throttled to PaintStrokeIntervalSeconds (~6Hz) so
        // strokes feel smooth without grinding the mesh kernel.
        if (_terraformMode && !Hud.IsAnyMenuOpen)
        {
            var phit = World.Raycast(
                Renderer.Camera.Position, Renderer.Camera.Front, maxDistance: 8f);
            if (phit.DidHit)
            {
                Hud.TerraformPreviewCenter = new System.Numerics.Vector3(
                    phit.BlockX + 0.5f, phit.BlockY + 0.5f, phit.BlockZ + 0.5f);
                Hud.TerraformPreviewRadius = _terraformRadius;

                // Paint-stroke: hold LMB to keep carving, RMB to keep
                // building. Skip the first hit (mouse-down handler already
                // ran a one-shot op) by gating on _lastPaintStroke being
                // recent enough.
                var now = DateTime.UtcNow;
                if ((now - _lastPaintStroke).TotalSeconds >= PaintStrokeIntervalSeconds)
                {
                    if (Input.IsLeftButtonDown)
                    {
                        ExecuteTerraform(phit, carve: true);
                        _lastPaintStroke = now;
                    }
                    else if (Input.IsRightButtonDown)
                    {
                        ExecuteTerraform(phit, carve: false);
                        _lastPaintStroke = now;
                    }
                }
            }
            else
            {
                Hud.TerraformPreviewCenter = null;
            }
        }
        else
        {
            Hud.TerraformPreviewCenter = null;
        }

        Wildlife.Tick(deltaTime, World, Renderer.Camera.Position, Time.IsNight);

        // Day/night transition latch. On falling edge (night->day) reset the
        // Pack Hunter night-kill counter so the 5-wolves-per-night target
        // becomes a fresh goal each night. Also re-arm the dusk warning.
        if (_wasNight && !Time.IsNight)
        {
            _wolvesKilledThisNight = 0;
            _duskWarned = false;
        }
        _wasNight = Time.IsNight;

        // Combo break: detect the falling edge of an active combo (was 2+
        // and now expired without a new kill). Plays a soft descending
        // beep so the player hears their streak ended.
        bool hasCombo = _killStreak >= 2 && DateTime.UtcNow <= _killStreakExpiry;
        if (_hadCombo && !hasCombo)
        {
            Audio.PlayBeep(220f, 0.25f, 0.10f, "triangle");
            _killStreak = 0;
            Hud.CurrentCombo = 0;
            Hud.ComboExpiry = DateTime.MinValue;
        }
        _hadCombo = hasCombo;

        // Dusk warning: one-shot toast when DayFraction enters the 0.50-0.58
        // window (late afternoon). Gives the player 8% of a day to prep
        // before the wolves spawn.
        float dayFrac = Time.DayFraction;
        if (!_duskWarned && dayFrac >= 0.50f && dayFrac < 0.58f)
        {
            _duskWarned = true;
            Hud.NotifyWarning("Nightfall approaches - stoke the fire");
        }
        // Campfire cook tick - converts raw meat to cooked while the player
        // loiters inside the warmth radius. Reset logic lives in the service
        // so we don't have to track proximity state here too.
        // Rain drowns fires faster: 1x at dry, up to 2.5x during downpour.
        // Cap so light drizzle barely changes anything and heavy storms
        // force the player to either cover the fire or stockpile wood.
        Fires.FuelDecayMultiplier = 1f + Weather.RainIntensity * 1.5f;
        Fires.Tick(deltaTime, Renderer.Camera.Position, Inventory);
        Ground.Tick(Renderer.Camera.Position, Inventory);

        // Auto-save every SaveService.AutoSaveIntervalSeconds seconds of active
        // play. Never fires while in a menu (we're gated above by IsAnyMenuOpen).
        _saveTimer += deltaTime;
        if (_saveTimer >= SaveService.AutoSaveIntervalSeconds)
        {
            _saveTimer = 0;
            Save.SaveNow(Renderer.Camera.Position, Renderer.Camera.Yaw, Renderer.Camera.Pitch);
        }

        // Camera sees the sprint gate too so we can't sprint-speed when stamina is
        // empty even if Shift is still held.
        // Strip any previously-applied bob so gravity / collision / ground-check
        // operates on the clean camera position. The bob gets re-applied at the
        // end of OnGameUpdate (or subtracted to zero if the player stopped).
        if (_bobAppliedY != 0 || _bobAppliedXOffset != 0 || _bobAppliedZOffset != 0)
        {
            var cp = Renderer.Camera.Position;
            Renderer.Camera.Position = new System.Numerics.Vector3(
                cp.X - _bobAppliedXOffset,
                cp.Y - _bobAppliedY,
                cp.Z - _bobAppliedZOffset);
        }

        // Save horizontal position, let camera move, then:
        //   1. If post-move is clear, keep it.
        //   2. Else try stepping UP one voxel - handles 1-block ledges, terraces,
        //      single-block obstacles without the player having to jump.
        //   3. Else revert XZ and try each axis independently so the player
        //      slides along walls instead of stopping dead at corners.
        var preMove = Renderer.Camera.Position;
        Renderer.Camera.ProcessKeyboard(Input.KeysDown, deltaTime, allowSprint: sprinting);
        var postMove = Renderer.Camera.Position;
        if (IsInsideSolidBlock(postMove))
        {
            var stepUp = new System.Numerics.Vector3(postMove.X, postMove.Y + 1f, postMove.Z);
            if (!IsInsideSolidBlock(stepUp))
            {
                // Commit the step-up; gravity will settle the camera on the new
                // terrain height next frame.
                Renderer.Camera.Position = stepUp;
            }
            else
            {
                // Wall too tall to step up. Axis-separated slide.
                Renderer.Camera.Position = new System.Numerics.Vector3(preMove.X, postMove.Y, preMove.Z);
                var tryX = new System.Numerics.Vector3(postMove.X, postMove.Y, preMove.Z);
                if (!IsInsideSolidBlock(tryX)) Renderer.Camera.Position = tryX;
                else
                {
                    var tryZ = new System.Numerics.Vector3(preMove.X, postMove.Y, postMove.Z);
                    if (!IsInsideSolidBlock(tryZ)) Renderer.Camera.Position = tryZ;
                }
            }
        }

        // Lifetime distance: take the horizontal delta from this frame's
        // committed position vs. the last frame's. Vertical movement (jump,
        // fall) doesn't count - matches what a player intuits as "distance
        // traveled across the world". Tracked across deaths + saves.
        var newPos = Renderer.Camera.Position;
        float walkDx = newPos.X - preMove.X;
        float walkDz = newPos.Z - preMove.Z;
        float horizDelta = MathF.Sqrt(walkDx * walkDx + walkDz * walkDz);
        if (horizDelta > 0.001f) Stats.AddDistance(horizDelta);

        var (dx, dy) = Input.ConsumeMouseDelta();
        if (dx != 0 || dy != 0)
            Renderer.Camera.ProcessMouseMovement((float)dx, (float)dy);

        // Vertical physics: gravity + ground clamp + jump impulse. Applied after
        // horizontal WASD so ground check sees the final XZ position this frame.
        ApplyGravityAndJump(deltaTime);

        // Camera bob: phase advances proportionally to walk/sprint; target
        // amplitudes smoothly blend toward zero when the player stops so the
        // camera doesn't snap. Applied as an offset on top of the stable
        // post-physics position.
        bool walking = _grounded && movingKey;
        if (walking)
        {
            _bobPhase += deltaTime * (sprinting ? BobSprintSpeed : BobWalkSpeed);
            // Exhaustion bob: when stamina is below 25% the player is gassed
            // and the head-bob amplitude grows ~50% to sell the heaving-
            // chest read. Recovers smoothly above 25% via the exp-approach.
            float exhMul = Stats.Stamina < 0.25f ? 1.5f : 1.0f;
            float targetY = MathF.Sin(_bobPhase) * BobAmplitudeY * exhMul;
            float targetX = MathF.Sin(_bobPhase * 0.5f) * BobAmplitudeX * exhMul;
            _bobCurrentY = ExpApproach(_bobCurrentY, targetY, BobSmoothing, deltaTime);
            _bobCurrentX = ExpApproach(_bobCurrentX, targetX, BobSmoothing, deltaTime);

            // Step audio: one tick per footfall (half the bob cycle). Tracks
            // floor(sin-phase) zero-crossings so sprint produces more steps
            // than walking without a second timer.
            _stepTimer += deltaTime;
            float stepInterval = sprinting ? 0.33f : 0.48f;
            if (_stepTimer >= stepInterval)
            {
                _stepTimer = 0;
                _stepAlt = !_stepAlt;
                // Sneak silences footsteps entirely - part of the stealth
                // mechanic. Water > rain > dry for the audible branches.
                bool sneakSilent = Input.KeysDown.Contains("ControlLeft")
                                 || Input.KeysDown.Contains("ControlRight");
                // Exhausted player can't fully stomp - skip every other
                // footstep below 20% stamina to read as "dragging your
                // feet". Sneak still wins (full silence).
                bool exhaustedSkip = Stats.Stamina < 0.20f && _stepAlt;
                if (sneakSilent) { /* no step sound */ }
                else if (exhaustedSkip) { /* dragging feet, every other step silent */ }
                else if (IsInWater()) Audio.PlayWaterStep(_stepAlt);
                else if (Weather.RainIntensity > 0.25f) Audio.PlayWaterStep(_stepAlt);
                else             Audio.PlayStep(_stepAlt);
                // Sprint kicks up small dust puffs at the player's feet.
                // Skip if sneaking (silent stealth = no visual tell either),
                // wading (water already splashes), or in heavy rain (mud,
                // not dust). Tiny 1-particle puff per footfall keeps it
                // subtle - hard to notice unless the player is sprinting.
                if (sprinting && !sneakSilent && !IsInWater() && Weather.RainIntensity < 0.25f)
                {
                    var camPos = Renderer.Camera.Position;
                    var feet = new System.Numerics.Vector3(camPos.X, camPos.Y - 1.6f, camPos.Z);
                    Hud.ShowDustPuff(feet, 1);
                }
            }
        }
        else
        {
            _bobCurrentY = ExpApproach(_bobCurrentY, 0f, BobSmoothing, deltaTime);
            _bobCurrentX = ExpApproach(_bobCurrentX, 0f, BobSmoothing, deltaTime);
            _stepTimer = 0;
        }

        var camNow = Renderer.Camera.Position;
        var right = Renderer.Camera.Right;
        _bobAppliedXOffset = right.X * _bobCurrentX;
        _bobAppliedZOffset = right.Z * _bobCurrentX;
        _bobAppliedX = _bobCurrentX;
        // Sneak crouch: drop the camera 0.4 blocks while CTRL is held so
        // the player visibly ducks. Applied as part of the bob offset so
        // it gets stripped + re-added cleanly each frame and doesn't
        // confuse the gravity/collision checks.
        bool ctrlHeld = Input.KeysDown.Contains("ControlLeft") || Input.KeysDown.Contains("ControlRight");
        float crouchOffset = ctrlHeld ? -0.4f : 0f;
        _bobAppliedY = _bobCurrentY + crouchOffset;
        Hud.SetBobOffset(_bobCurrentX, _bobAppliedY);
        Renderer.Camera.Position = new System.Numerics.Vector3(
            camNow.X + _bobAppliedXOffset,
            camNow.Y + _bobAppliedY,
            camNow.Z + _bobAppliedZOffset);

        // Crosshair turns target-colored when a block is within E-press reach.
        // Same 5m range as HandleInteract uses so the visual matches actual ability.
        var targetHit = World.Raycast(Renderer.Camera.Position, Renderer.Camera.Front, 5f);

        // Entity check first - an aim-locked entity takes priority over any
        // block behind it (matches HandleInteract's hit-test order). Uses the
        // same cone parameters as combat so the prompt only shows when a
        // swing would actually land.
        var targetEntity = Wildlife.FindTargetInCone(
            Renderer.Camera.Position, Renderer.Camera.Front, maxDist: 5f, minDot: 0.95f);

        if (targetEntity is not null)
        {
            // Hostile tint for entity aim - the crosshair goes red so the
            // player sees "this is a kill swing" at a glance. Prompt includes
            // HP % so the player can tell if the next swing will finish the
            // kill without having to squint at the billboard bar. A
            // charging entity gets a "[CHARGING]" suffix as a tactical
            // warning.
            Hud.Crosshair.TargetType = SpawnDev.GameUI.Elements.CrosshairTarget.Hostile;
            int hpPct = (int)(100f * targetEntity.Health / Math.Max(0.001f, targetEntity.MaxHealth));
            string charging = targetEntity.Alert == LostSpawns.Services.AlertMode.Charge
                ? "  [CHARGING]" : "";
            Hud.InteractionPrompt.Text = $"[LMB] Attack {targetEntity.Kind} ({hpPct}%){charging}";
        }
        else if (targetHit.DidHit)
        {
            // Green interactive tint for breakable blocks.
            Hud.Crosshair.TargetType = SpawnDev.GameUI.Elements.CrosshairTarget.Interactive;
            Hud.InteractionPrompt.Text = BuildInteractionPromptText((LostSpawns.Models.BlockType)targetHit.BlockType);
        }
        else if (Inventory.ActiveItem?.Id == "tool.bow")
        {
            // Bow with no target in sight: show arrow count so the player
            // can tell if they're out of ammo without opening the inventory.
            Hud.Crosshair.TargetType = SpawnDev.GameUI.Elements.CrosshairTarget.None;
            int arrows = CountInventory("material.feather");
            Hud.InteractionPrompt.Text = arrows > 0
                ? $"[RMB] Shoot ({arrows} arrows)"
                : "Need feathers for arrows";
        }
        else
        {
            Hud.Crosshair.TargetType = SpawnDev.GameUI.Elements.CrosshairTarget.None;
            Hud.InteractionPrompt.Text = "";
        }

        // Update desired chunks (dispatches GPU tasks, unloads distant chunks + their GPU buffers)
        World.UpdateDesiredChunks(Renderer.Camera.Position, Settings.DrawDistance);

        // Dequeue GPU-ready chunks into the active dictionary (RenderService reads directly)
        World.ProcessReadyChunks(16);

        // Update GPU-rendered HUD (compass bearing, minimap position, animations)
        Hud.Update(deltaTime, Renderer.Camera.Position, Renderer.Camera.Yaw);

        // FPS counter (still needed for debug overlay data)
        _frameCount++;
        _fpsTimer += deltaTime;
        if (_fpsTimer >= 1.0)
        {
            _fpsText = $"{_frameCount} FPS";
            _frameCount = 0;
            _fpsTimer = 0;
        }
    }

    private void OnCanvasClick()
    {
        // Canvas click is a user-gesture so it's the right moment to wake up
        // the AudioContext (browsers refuse to start audio without one). Safe
        // to call repeatedly; EnsureActive is idempotent. Pull volume from
        // the persisted setting every init so saved preferences apply
        // immediately.
        Audio.EnsureActive();
        Audio.MasterVolume = Settings.MasterVolume;

        if (Input.IsPointerLocked) return;
        try
        {
            using var canvas = new HTMLCanvasElement(_canvasRef);
            canvas.RequestPointerLock();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Game] Pointer lock failed: {ex.Message}");
        }
    }

    public ValueTask DisposeAsync()
    {
        Input.OnEscapePressed -= HandleEscape;
        Input.OnPointerLockChanged -= HandlePointerLockChanged;
        Input.OnInventoryTogglePressed -= HandleInventoryToggle;
        Input.OnCraftingTogglePressed -= HandleCraftingToggle;
        Input.OnFeedFirePressed -= HandleFeedFire;
        Input.OnSleepPressed -= HandleSleep;
        Input.OnDebugTogglePressed -= HandleDebugToggle;
        Input.OnMuteTogglePressed -= HandleMuteToggle;
        Input.OnHelpTogglePressed -= HandleHelpToggle;
        Input.OnDropPressed -= HandleDropActive;
        Input.OnQuickEatPressed -= HandleQuickEat;
        Input.OnQuickDrinkPressed -= HandleQuickDrink;
        Input.OnQuickHealPressed -= HandleQuickHeal;
        Input.OnTerraformTogglePressed -= HandleTerraformToggle;
        Input.OnWheelScrolled -= HandleWheelScrolled;
        if (_doc is not null) _doc.OnVisibilityChange -= HandleVisibilityChange;
        _doc?.Dispose();
        _doc = null;
        Input.OnInteractPressed -= HandleInteract;
        Input.OnLeftClickPressed -= HandleInteract;
        Input.OnRightClickPressed -= HandlePlaceBlock;
        Input.OnDebugDamagePressed -= HandleDebugDamage;
        Input.OnDebugHealPressed -= HandleDebugHeal;
        Hud.OnResumeClicked -= HandleResumeClicked;
        Hud.OnQuitToMenuClicked -= HandleQuitToMenuClicked;
        Hud.OnRespawnClicked -= HandleRespawnClicked;
        Stats.OnDied -= HandleDied;
        Wildlife.OnEntityKilled -= HandleEntityKilled;
        Wildlife.OnEntityHit -= HandleEntityHitAudio;
        Wildlife.OnContactAttack -= HandleEntityContactAttack;
        Fires.OnCooked -= HandleCooked;
        Fires.OnLowFuel -= HandleLowFuel;
        Fires.OnExtinguished -= HandleFireExtinguished;
        Save.OnSaved -= HandleSaved;
        Time.OnDayAdvanced -= HandleDayAdvanced;
        Ground.OnPickedUp -= HandleGroundPickup;
        Ground.OnPickedUpAt -= HandleGroundPickupAt;
        Stats.OnLevelUp -= HandleLevelUpSound;
        Stats.OnHealed -= HandleHealSound;
        Wildlife.OnEntitySpawned -= HandleEntitySpawned;
        Crafter.OnCrafted -= HandleCraftedSound;
        Stats.OnFirstKill -= HandleFirstKill;
        Stats.OnAchievement -= HandleAchievement;
        Inventory.OnItemConsumed -= HandleItemConsumedSound;
        Inventory.OnItemPickedUp -= HandleItemPickedUpSound;
        Weather.OnLightningStrike -= HandleLightningSound;

        Renderer.StopRenderLoop();
        Hud.Dispose();
        Renderer.Dispose();
        World.Reset();
        Input.Detach();
        return ValueTask.CompletedTask;
    }
}

