@page "/game"
@using SpawnDev.BlazorJS.JSObjects
@using LostSpawns.Models
@using LostSpawns.Rendering
@inject VoxelEngineService Engine
@inject InputService Input
@inject RenderService Renderer
@inject WorldService World
@inject SettingsService Settings
@inject HudService Hud
@inject PlayerStatsService Stats
@inject WorldTimeService Time
@inject WeatherService Weather
@inject EntityService Wildlife
@inject CampfireService Fires
@inject GroundItemService Ground
@inject AudioService Audio
@inject CraftingService Crafter
@inject InventoryService Inventory
@inject SaveService Save
@inject SpawnDev.BlazorJS.BlazorJSRuntime JS
@inject NavigationManager Nav
@implements IAsyncDisposable

<PageTitle>Lost Spawns — Game</PageTitle>

@if (!_ready)
{
    <div class="game-loading">
        <div class="game-loading-inner">
            <h2 class="glow-text">INITIALIZING</h2>
            <p class="text-dim">@_status</p>
        </div>
    </div>
}

<div class="game-container">
    <canvas id="gameCanvas" @ref="_canvasRef" width="1280" height="720"
            tabindex="0" @onclick="OnCanvasClick"></canvas>
</div>

@code {
    private ElementReference _canvasRef;
    private bool _ready;
    private string _status = "";
    private string _fpsText = "";
    private int _frameCount;
    private double _fpsTimer;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        _status = "Creating GPU context…";
        StateHasChanged();

        await Engine.InitAsync();

        _status = "Building render pipeline…";
        StateHasChanged();

        using var canvas = new HTMLCanvasElement(_canvasRef);
        Renderer.Init(canvas, Engine.Accelerator!, World);

        _status = "Loading terrain data…";
        StateHasChanged();

        // Load real-world Deer Isle heightmap
        var heightmapLoader = new LostSpawns.Services.HeightmapLoader();
        try
        {
            await heightmapLoader.LoadAsync(JS, "maps/deer_isle.heightmap");
            heightmapLoader.SetCellSize(15.62f); // 16km / 1024 grid
            World.InitWithHeightmap(heightmapLoader, seed: 42);
            _status = "Deer Isle terrain loaded!";
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Game] Heightmap load failed: {ex.Message}, falling back to procedural");
            World.Init(seed: 42);
        }
        StateHasChanged();

        // Camera above terrain - spawn on the island, not in the ocean
        int spawnHeight = World.GetHeightAt(0, 0);
        // If spawn is underwater, find higher ground nearby
        if (spawnHeight <= 64) // 64 = sea level in HeightmapLoader
        {
            for (int search = 1; search < 200; search += 4)
            {
                int h = World.GetHeightAt(search * 16, search * 16);
                if (h > 68) { spawnHeight = h; break; }
            }
        }
        // Spawn camera a few blocks above the terrain top so gravity settles the
        // player cleanly on the grass. EyeHeight 1.8 = eyes; adding 2 = small fall.
        Renderer.Camera.Position = new System.Numerics.Vector3(0, spawnHeight + EyeHeight + 2f, 0);
        Renderer.Camera.Yaw = 45f;
        Renderer.Camera.Pitch = -15f;

        // Initialize GPU-rendered HUD overlay FIRST so the loading screen can render
        // on top of the canvas while GenerateChunksAsync chews through the initial radius.
        // Previously the player saw a black canvas for ~15s with no feedback.
        Hud.Init(Renderer, _canvasRef);

        Input.Attach();
        Input.OnEscapePressed += HandleEscape;
        Input.OnPointerLockChanged += HandlePointerLockChanged;
        Input.OnInventoryTogglePressed += HandleInventoryToggle;
        Input.OnCraftingTogglePressed += HandleCraftingToggle;
        Input.OnFeedFirePressed += HandleFeedFire;
        Input.OnSleepPressed += HandleSleep;
        Input.OnDebugTogglePressed += HandleDebugToggle;
        Input.OnMuteTogglePressed += HandleMuteToggle;
        Input.OnHelpTogglePressed += HandleHelpToggle;
        Input.OnDropPressed += HandleDropActive;

        // Auto-pause when the player tabs away. Browser fires visibilitychange
        // on document; SpawnDev.BlazorJS wraps it as a typed ActionEvent so we
        // can += / -= without raw addEventListener.
        _doc = JS.Get<SpawnDev.BlazorJS.JSObjects.Document>("document");
        _doc.OnVisibilityChange += HandleVisibilityChange;
        Input.OnInteractPressed += HandleInteract;
        Input.OnLeftClickPressed += HandleInteract;       // L-click = break, same as E
        Input.OnRightClickPressed += HandlePlaceBlock;    // R-click = place active hotbar material
        Input.OnDebugDamagePressed += HandleDebugDamage;
        Input.OnDebugHealPressed += HandleDebugHeal;
        Hud.OnResumeClicked += HandleResumeClicked;
        Hud.OnQuitToMenuClicked += HandleQuitToMenuClicked;
        Hud.OnRespawnClicked += HandleRespawnClicked;
        Stats.OnDied += HandleDied;
        Wildlife.OnEntityKilled += HandleEntityKilled;
        Wildlife.OnEntityHit += HandleEntityHitAudio;
        Wildlife.OnContactAttack += HandleEntityContactAttack;
        Fires.OnCooked += HandleCooked;
        Fires.OnLowFuel += HandleLowFuel;
        Save.OnSaved += HandleSaved;
        Time.OnDayAdvanced += HandleDayAdvanced;
        Ground.OnPickedUp += HandleGroundPickup;
        Stats.OnLevelUp += HandleLevelUpSound;
        Stats.OnHealed += HandleHealSound;
        Wildlife.OnEntitySpawned += HandleEntitySpawned;
        Crafter.OnCrafted += HandleCraftedSound;
        Stats.OnFirstKill += HandleFirstKill;
        Stats.OnAchievement += HandleAchievement;
        Inventory.OnItemConsumed += HandleItemConsumedSound;
        Inventory.OnItemPickedUp += HandleItemPickedUpSound;
        Weather.OnLightningStrike += HandleLightningSound;

        Renderer.OnUpdate = OnGameUpdate;

        // Swap the HTML "INITIALIZING" splash for the canvas + GameUI loading overlay.
        _ready = true;
        _status = "";
        StateHasChanged();

        // Start RAF so the loading overlay animates while we await chunk generation.
        // OnGameUpdate short-circuits to Hud.Update-only while Hud.IsLoading, so the
        // camera + input feed doesn't run yet.
        Hud.ShowLoadingScreen();
        Renderer.StartRenderLoop();

        // Initial chunks - small radius for fast startup (streaming fills the rest).
        // Awaited here; OnGameUpdate drives the progress bar from World.LoadedSections.
        const int InitialRadius = 4;
        _initialLoadExpectedColumns = CountColumnsInRadius(InitialRadius);
        var initialCount = await World.GenerateChunksAsync(
            Renderer.Camera.Position, InitialRadius);

        Console.WriteLine($"[Game] Loaded {initialCount} columns, {World.LoadedSections} sections");

        // Queue remaining chunks — GPU kernel generates heightmaps async
        World.UpdateDesiredChunks(Renderer.Camera.Position, Settings.DrawDistance);

        // Seed wildlife near spawn. World already has heights for the initial
        // radius so GetHeightAt calls are cheap. Entities appear as colored dots
        // on the minimap immediately; 3D rendering of their bodies is a follow-up.
        Wildlife.SpawnStarter(Renderer.Camera.Position, World);

        // Drop a starter campfire a couple blocks east of spawn. Gives the
        // player an obvious warmth anchor and a target for future "cook meat"
        // interactions without forcing them to gather fuel before they can
        // survive their first cold tick.
        if (Fires.Fires.Count == 0)
        {
            var fireXZ = new System.Numerics.Vector3(3, 0, 0);
            int fireY = World.GetHeightAt(Renderer.Camera.Position.X + fireXZ.X,
                                          Renderer.Camera.Position.Z + fireXZ.Z) + 1;
            Fires.Spawn(new System.Numerics.Vector3(
                Renderer.Camera.Position.X + fireXZ.X,
                fireY,
                Renderer.Camera.Position.Z + fireXZ.Z));
        }

        // Restore save if one exists - applies stats / inventory / time / clock
        // and teleports the camera to the saved position. Blocks lost on reload
        // until world-diff persistence lands.
        var restored = Save.TryLoad();
        if (restored.HasValue)
        {
            Renderer.Camera.Position = restored.Value.Position;
            Renderer.Camera.Yaw = restored.Value.Yaw;
            Renderer.Camera.Pitch = restored.Value.Pitch;
            _verticalVelocity = 0;
            _peakFallSpeed = 0;
            _grounded = false;
            Hud.NotifySuccess("Save restored");
        }

        Hud.HideLoadingScreen();
    }

    // Save-to-localStorage autosave timer. Runs inside OnGameUpdate so time is
    // paused when the player is - no snapshot during death screen / inventory /
    // settings. Reset to 0 here; incremented each gameplay frame.
    private float _saveTimer;

    private int _initialLoadExpectedColumns = 49; // radius 4 circle fallback

    // Vertical physics. Gravity pulls the camera down each frame; a downward
    // raycast finds the terrain and clamps the camera to block_top + EyeHeight.
    // Jump writes a positive impulse into _verticalVelocity and Space releases
    // the fly-forever behavior of the old code.
    private float _verticalVelocity;
    private bool _grounded;

    // Footstep audio cadence - ticks between footfalls. Alternates pitch
    // between consecutive steps so left/right foot sound slightly different.
    private float _stepTimer;
    private bool _stepAlt;

    // Fire crackle cadence - seconds between ambient fire pops when the
    // player is in a fire's warmth aura. Randomized jitter at the fire each
    // time so crackles don't land on a clock.
    private float _crackleTimer;
    private readonly Random _crackleRng = new();
    private float _distantHowlTimer;
    private readonly Random _howlRng = new();

    // Owl hoots at deep night (0.72-0.88 day fraction). Rare ambient call
    // with a jittered interval so it doesn't loop obviously.
    private float _owlTimer;
    private readonly Random _owlRng = new();

    // Dawn bird chirps (0.06-0.18 day fraction). Short cheerful trills
    // that celebrate the sun coming up.
    private float _birdTimer;
    private readonly Random _birdRng = new();

    // Heartbeat cadence - pulses accelerate as HP drops, silences when the
    // player recovers past the low-HP threshold.
    private float _heartbeatTimer;

    // Low-stamina gasp cadence + prev-frame latch so the first-cross gasp
    // fires immediately, then repeats on a slow cadence while still low.
    private float _gaspTimer;
    private bool _wasStaminaLow;

    /// <summary>Seconds remaining on the post-respawn HP-regen grace window.</summary>
    private float _resurrectGraceTimer;

    // Kill-streak combo state. Each kill within KillStreakWindow seconds of
    // the last bumps the counter and the next kill gets an XP multiplier.
    // Resets on timeout or death.
    private int _killStreak;
    private DateTime _killStreakExpiry;
    private const float KillStreakWindow = 8f;

    // Wolves killed during the current night. Resets at each dawn (tracked
    // by the _wasNight latch). Earning 5 in one night fires Pack Hunter.
    private int _wolvesKilledThisNight;
    private bool _wasNight;

    // Document handle for visibility-change auto-pause. Disposed in
    // DisposeAsync alongside the rest of the JS interop teardown.
    private SpawnDev.BlazorJS.JSObjects.Document? _doc;

    private void HandleVisibilityChange(SpawnDev.BlazorJS.JSObjects.Event _)
    {
        // When the tab is hidden, push the pause menu so the player isn't
        // bleeding hunger / thirst while AFK in a background tab. When the
        // tab returns we leave it paused - they'll click through the menu
        // intentionally to resume.
        if (_doc is not null && _doc.Hidden && !Hud.IsPaused && !Hud.IsDead)
            Hud.ShowPauseMenu();
    }

    // Cricket chirps - random-jittered cadence while it's dark so the world
    // doesn't sound completely silent at night.
    private float _cricketTimer;
    private readonly Random _cricketRng = new();
    private float _peakFallSpeed; // max |negative velocity| seen this airborne segment
    private const float Gravity = 20f;         // units/sec^2
    private const float JumpImpulse = 7f;      // units/sec; peak ~1.2 blocks
    private const float EyeHeight = 1.8f;      // camera above feet
    private const float GroundCheckRange = 3f; // raycast distance below camera
    private const float SafeFallSpeed = 8f;    // u/s; ~3-block fall, no damage
    private const float FallDamageScale = 0.15f; // HP damage per (speed - safe) u/s

    // Cooldown between successive block actions (break or place). Tuned so a fast
    // double-click chops exactly once; rapid auto-fire is blocked at the source.
    private const float BlockActionCooldownSec = 0.25f;
    private const float BlockActionStaminaCost = 0.04f;
    private DateTime _lastBlockActionTime = DateTime.MinValue;

    // Camera bob while walking. Phase advances with horizontal speed; offsets
    // are applied on top of the clean camera position AT THE END of the update
    // and the previous frame's applied offsets are removed first so bob never
    // leaks into gravity + collision + ground-check math.
    private float _bobPhase;
    private float _bobCurrentY;
    private float _bobCurrentX;
    private float _bobAppliedX;
    private float _bobAppliedY;
    private float _bobAppliedXOffset; // world-space X contribution from lateral sway
    private float _bobAppliedZOffset; // world-space Z contribution from lateral sway
    private const float BobWalkSpeed = 8f;       // rad/sec of bob phase while walking
    private const float BobSprintSpeed = 13f;    // rad/sec of bob phase while sprinting
    private const float BobAmplitudeY = 0.08f;   // vertical bob meters
    private const float BobAmplitudeX = 0.05f;   // lateral sway meters
    private const float BobSmoothing = 8f;       // exp-decay per second back to zero when stopping

    // Exponential approach: smoothly glide `current` toward `target` at a rate
    // where `rate=8` means roughly halfway in ~0.09s. dt-scaled so the feel is
    // the same at 30 or 240 fps.
    private static float ExpApproach(float current, float target, float rate, float dt)
    {
        float k = 1f - MathF.Exp(-rate * dt);
        return current + (target - current) * k;
    }

    private bool IsInsideSolidBlock(System.Numerics.Vector3 camPos)
    {
        // Player occupies a single-block AABB from feet (camPos.Y - EyeHeight) up
        // to head (camPos.Y). Sample the two extremes - a taller capsule would
        // check the middle too, but our EyeHeight (1.8) keeps head + feet within
        // two adjacent voxels so this catches anything in between.
        int ix = (int)MathF.Floor(camPos.X);
        int iz = (int)MathF.Floor(camPos.Z);
        int feetY = (int)MathF.Floor(camPos.Y - EyeHeight + 0.1f);
        int headY = (int)MathF.Floor(camPos.Y - 0.1f);
        return World.IsSolidAt(ix, feetY, iz) || World.IsSolidAt(ix, headY, iz);
    }

    private bool IsInWater()
    {
        var pos = Renderer.Camera.Position;
        int ix = (int)MathF.Floor(pos.X);
        int iz = (int)MathF.Floor(pos.Z);
        int feetY = (int)MathF.Floor(pos.Y - EyeHeight + 0.1f);
        return World.GetBlockAt(ix, feetY, iz) == LostSpawns.Models.BlockType.Water;
    }

    private void ApplyGravityAndJump(float dt)
    {
        // Water-reduced gravity: swimming is floatier than free-fall. Classic
        // Minecraft-style "hold space to ascend" handled further down.
        bool inWater = IsInWater();
        float gravity = inWater ? Gravity * 0.3f : Gravity;

        // Apply gravity to vertical velocity every tick. Ground check then
        // cancels downward motion + snaps to block_top + EyeHeight if we've
        // fallen into / onto terrain.
        _verticalVelocity -= gravity * dt;

        // In water, cap downward speed so the player sinks slowly, and apply a
        // gentle upward thrust when Space is held (swim up).
        if (inWater)
        {
            if (_verticalVelocity < -3f) _verticalVelocity = -3f;
            if (Input.KeysDown.Contains("Space")) _verticalVelocity += 20f * dt;
            if (_verticalVelocity > 4f) _verticalVelocity = 4f; // cap ascent too
        }

        var cam = Renderer.Camera;
        var pos = cam.Position;

        // Safety: if the camera somehow falls below the loaded world (player
        // walked off the map edge, initial spawn raycast missed), respawn at
        // the heightmap surface instead of freefalling into the void.
        if (pos.Y < -8f)
        {
            int h = World.GetHeightAt(pos.X, pos.Z);
            pos.Y = h + EyeHeight + 2f;
            _verticalVelocity = 0;
        }

        // Apply vertical motion first, then check ground to snap if we passed
        // through the surface this frame.
        pos.Y += _verticalVelocity * dt;

        var down = new System.Numerics.Vector3(0, -1, 0);
        var hit = World.Raycast(pos, down, GroundCheckRange);
        if (hit.DidHit)
        {
            // Raycast reports the hit block's integer coordinates + hit face. For
            // a -Y ray the player lands on the +Y face of the block below, so the
            // walkable top surface is at (BlockY + 1).
            float groundTop = hit.BlockY + 1f;
            float minEyeY = groundTop + EyeHeight;

            if (pos.Y <= minEyeY)
            {
                pos.Y = minEyeY;
                if (_verticalVelocity < 0) _verticalVelocity = 0;
                bool justLanded = !_grounded;
                _grounded = true;

                // On landing, apply fall damage scaled to the peak downward speed
                // seen during this airborne segment. Reset so the next fall starts
                // fresh. Water landings are safe - belly-flop a cliff into a pond
                // without paying the HP cost.
                if (justLanded && _peakFallSpeed > SafeFallSpeed && !inWater)
                {
                    float excess = _peakFallSpeed - SafeFallSpeed;
                    float dmg = excess * FallDamageScale;
                    Stats.TakeDamage(dmg);
                }
                // Landing audio - gain scales with peak fall speed so big
                // drops thud harder than hops. Water landings get a splash
                // instead of a thud; only plays on actual landings, not each
                // frame we're grounded.
                if (justLanded)
                {
                    if (inWater) Audio.PlaySplash();
                    else Audio.PlayLand(_peakFallSpeed / 20f);
                }
                _peakFallSpeed = 0;
            }
            else
            {
                _grounded = false;
                if (-_verticalVelocity > _peakFallSpeed) _peakFallSpeed = -_verticalVelocity;
            }
        }
        else
        {
            _grounded = false;
            if (-_verticalVelocity > _peakFallSpeed) _peakFallSpeed = -_verticalVelocity;
        }

        // Jump only works grounded AND not in water - swim-up handles Space in water.
        // Eats a bit of stamina so you can't hop-spam away from predators forever.
        if (!inWater && _grounded && Input.KeysDown.Contains("Space") && Stats.Stamina > 0.05f)
        {
            _verticalVelocity = JumpImpulse;
            Stats.Stamina = Stats.Stamina - 0.05f;
            _grounded = false;
            Audio.PlayJump();
        }

        cam.Position = pos;
    }

    private bool BlockActionReady()
    {
        var now = DateTime.UtcNow;
        if ((now - _lastBlockActionTime).TotalSeconds < BlockActionCooldownSec) return false;
        if (Stats.Stamina < BlockActionStaminaCost) return false;
        return true;
    }

    private void ConsumeBlockActionCost()
    {
        _lastBlockActionTime = DateTime.UtcNow;
        Stats.Stamina = Stats.Stamina - BlockActionStaminaCost;
    }

    private static int CountColumnsInRadius(int radius)
    {
        int r2 = radius * radius;
        int count = 0;
        for (int dx = -radius; dx <= radius; dx++)
        for (int dz = -radius; dz <= radius; dz++)
            if (dx * dx + dz * dz <= r2) count++;
        return count;
    }

    private void HandleEscape()
    {
        // Priority unwinds the screen stack one at a time, top first: settings
        // overlay (pushed from pause menu) -> inventory -> pause. Loading + death
        // ignore Escape entirely (death requires clicking Respawn; loading only
        // dismisses itself when chunk gen completes).
        if (Hud.IsLoading || Hud.IsDead) return;
        if (Hud.IsSettingsOpen)  { Hud.HideSettings();  return; }
        if (Hud.IsCraftingOpen)  { Hud.HideCrafting();  return; }
        if (Hud.IsInventoryOpen) { Hud.HideInventory(); return; }
        if (Hud.IsPaused) HandleResumeClicked();
        else Hud.ShowPauseMenu();
    }

    private void HandleInventoryToggle()
    {
        // Don't let inventory open on top of another modal - loading, pause, and
        // settings all own the screen and should not be pushed over. If the
        // inventory itself is already up, the toggle closes it (handled inside
        // Hud.ToggleInventory).
        if (Hud.IsInventoryOpen) { Hud.ToggleInventory(); return; }
        if (Hud.IsLoading || Hud.IsPaused || Hud.IsSettingsOpen || Hud.IsCraftingOpen || Hud.IsDead) return;
        Hud.ToggleInventory();
    }

    private void HandleCraftingToggle()
    {
        if (Hud.IsCraftingOpen) { Hud.ToggleCrafting(); return; }
        if (Hud.IsLoading || Hud.IsPaused || Hud.IsSettingsOpen || Hud.IsInventoryOpen || Hud.IsDead) return;
        Hud.ToggleCrafting();
    }

    // Dev keybinds for testing the damage/heal UX. Remove once real combat /
    // consumption sources replace them.
    private void HandleDebugDamage() => Stats.TakeDamage(0.1f);
    private void HandleDebugHeal()   => Stats.Heal(0.1f);

    /// <summary>
    /// One-shot camera flinch used by every successful swing. Just bumps
    /// Pitch up a few degrees; the player's own mouse look naturally
    /// recovers the view, so no separate decay channel or timer is needed.
    /// Feels like the tool weight kicked the camera back.
    /// </summary>
    private void ApplyCameraKick()
    {
        Renderer.Camera.Pitch = Math.Clamp(Renderer.Camera.Pitch + 2.5f, -89f, 89f);
        // Viewmodel swing pairs with every kick - same trigger point, same
        // success conditions. Both feel like "the tool just landed / loosed".
        Hud.TriggerSwing();
    }

    /// <summary>
    /// Tick the active tool's durability once per successful swing and toast
    /// on break. Tools with no durability (hands + most items) no-op. Kept
    /// out of InventoryService so the gameplay-facing toast phrasing lives
    /// with the other combat / block-break side effects.
    /// </summary>
    private void DegradeActiveToolWithFeedback()
    {
        var (broke, toolName) = Inventory.DegradeActiveTool();
        if (broke && toolName is not null)
            Hud.NotifyWarning($"{toolName} broke");
    }

    private void HandleInteract()
    {
        // Interaction is locked behind active gameplay - pause / inventory / loading
        // all short-circuit via IsAnyMenuOpen so accidentally chopping through a menu
        // doesn't happen.
        if (Hud.IsAnyMenuOpen) return;
        if (!BlockActionReady()) return;

        var origin = Renderer.Camera.Position;
        var dir = Renderer.Camera.Front;

        // Entity hit-test runs BEFORE the block raycast so you can punch a
        // wandering rabbit even if there's a tree behind it. Cone dot 0.95
        // (~18 deg half-angle) gives a bit of melee aim assist without being
        // a free-win autolock; range 5 blocks matches the block-break reach.
        var target = Wildlife.FindTargetInCone(origin, dir, maxDist: 5f, minDot: 0.95f);
        if (target is not null)
        {
            float dmg = DamageForEquippedTool();
            Wildlife.ApplyDamage(target, dmg, origin);
            ConsumeBlockActionCost();
            ApplyCameraKick();
            DegradeActiveToolWithFeedback();
            Audio.PlayHit();
            Hud.ShowDamageNumber(target.Position, dmg);
            return;
        }

        var hit = World.Raycast(origin, dir, maxDistance: 5f);
        if (!hit.DidHit) { Audio.PlayWhoosh(); return; }

        // Peek at the target block before breaking - tool requirement check.
        var targetType = (LostSpawns.Models.BlockType)hit.BlockType;
        var requiredTool = RequiredToolForBlockType(targetType);
        if (requiredTool != null && !IsToolInFamily(Inventory.ActiveItem?.Id, requiredTool))
        {
            // Phrase the toast from the tool's Id. "tool.axe" -> "Axe".
            string toolName = requiredTool.StartsWith("tool.")
                ? char.ToUpper(requiredTool[5]) + requiredTool[6..]
                : requiredTool;
            Hud.NotifyWarning($"Need a {toolName}");
            return;
        }

        var brokenType = World.TryBreakBlock(hit.BlockX, hit.BlockY, hit.BlockZ);
        if (brokenType == LostSpawns.Models.BlockType.Air) { Audio.PlayWhoosh(); return; }

        // Successful swing charges the cooldown + stamina cost. Missed swings (air,
        // out of range, wrong tool) don't cost anything so the player can re-aim.
        ConsumeBlockActionCost();
        ApplyCameraKick();
        DegradeActiveToolWithFeedback();
        Stats.AwardXp(1);
        // Tool-specific hit sound: wood-chop for axe-breakable blocks,
        // stone-mine for pick-breakable, generic thud for anything else.
        var req = RequiredToolForBlockType(brokenType);
        if (req == "tool.axe")        Audio.PlayChop();
        else if (req == "tool.pick")  Audio.PlayMine();
        else                          Audio.PlayHit();

        var drop = DropForBlockType(brokenType);
        if (drop is null)
        {
            Hud.Notify($"Broke {brokenType}");
            return;
        }

        bool added = Inventory.TryAdd(drop);
        if (added) Hud.NotifySuccess($"+1 {drop.Name}");
        else Hud.NotifyWarning($"Inventory full - {drop.Name} dropped");
    }

    /// <summary>
    /// True if the active item belongs to the same tool family as the required
    /// item - covers tier upgrades (stone_axe satisfies axe). Null active
    /// never satisfies; exact match is the cheapest path.
    /// </summary>
    private static bool IsToolInFamily(string? activeId, string requiredId)
    {
        if (activeId == null) return false;
        if (activeId == requiredId) return true;
        return (requiredId, activeId) switch
        {
            ("tool.axe",  "tool.stone_axe")  => true,
            ("tool.pick", "tool.stone_pick") => true,
            _ => false,
        };
    }

    /// <summary>
    /// Returns the item Id of the tool required to break the given block, or null
    /// if hands are enough. Keeping the mapping local to Game.razor so gameplay
    /// knobs (which tools unlock which blocks) stay out of the general inventory /
    /// world services.
    /// </summary>
    private static string? RequiredToolForBlockType(LostSpawns.Models.BlockType t) => t switch
    {
        LostSpawns.Models.BlockType.Wood   => "tool.axe",
        LostSpawns.Models.BlockType.Leaves => "tool.axe",
        LostSpawns.Models.BlockType.Stone  => "tool.pick",
        _ => null,
    };

    private string BuildInteractionPromptText(LostSpawns.Models.BlockType t)
    {
        var required = RequiredToolForBlockType(t);
        string verb = t switch
        {
            LostSpawns.Models.BlockType.Wood   => "Chop",
            LostSpawns.Models.BlockType.Leaves => "Clear",
            LostSpawns.Models.BlockType.Stone  => "Mine",
            LostSpawns.Models.BlockType.Dirt   => "Dig",
            LostSpawns.Models.BlockType.Grass  => "Dig",
            LostSpawns.Models.BlockType.Sand   => "Dig",
            LostSpawns.Models.BlockType.Water  => "", // not interactive
            _ => "Break",
        };
        if (string.IsNullOrEmpty(verb)) return "";

        if (required != null && Inventory.ActiveItem?.Id != required)
        {
            string toolName = required.StartsWith("tool.")
                ? char.ToUpper(required[5]) + required[6..]
                : required;
            return $"Need a {toolName}";
        }
        return $"[E] {verb}";
    }

    /// <summary>
    /// How much damage a single melee swing deals, based on what's in the
    /// active hotbar slot. Bare hands are deliberately weak so the Axe / Pick
    /// feel meaningful; Pick is marginally better at combat than an Axe since
    /// it's got a point on it. Numbers are tuned for ~3-4 hits on a starter
    /// entity (rabbit has 1.0 health, boar can soak more later).
    /// </summary>
    private float DamageForEquippedTool()
    {
        var id = Inventory.ActiveItem?.Id;
        return id switch
        {
            "tool.stone_axe"  => 0.85f,
            "tool.stone_pick" => 0.65f,
            "tool.axe"        => 0.55f,
            "tool.pick"       => 0.40f,
            _                 => 0.20f, // bare hands / any other item
        };
    }

    /// <summary>
    /// Loot table for a killed entity. Returns the single inventory stack we
    /// award on death. null means "nothing drops" which we don't currently
    /// use, but the switch is written tolerant so future EntityKinds can
    /// return null.
    /// </summary>
    private static LostSpawns.Services.InventoryItem? LootForEntityKind(LostSpawns.Services.EntityKind k) => k switch
    {
        LostSpawns.Services.EntityKind.Rabbit => new("food.rabbit_meat", "Rabbit Meat", 1, LostSpawns.Services.ItemCategory.Food),
        LostSpawns.Services.EntityKind.Boar   => new("food.boar_meat",   "Boar Meat",   2, LostSpawns.Services.ItemCategory.Food),
        LostSpawns.Services.EntityKind.Crow   => new("material.feather", "Feather",     1, LostSpawns.Services.ItemCategory.Material),
        LostSpawns.Services.EntityKind.Wolf   => new("material.pelt",    "Wolf Pelt",   1, LostSpawns.Services.ItemCategory.Material),
        LostSpawns.Services.EntityKind.Deer   => new("food.deer_meat",   "Deer Meat",   3, LostSpawns.Services.ItemCategory.Food),
        _ => null,
    };

    private void HandleEntityKilled(LostSpawns.Services.WanderingEntity e)
    {
        // XP reward by kind - higher threats give more. Survives respawn per
        // PlayerStatsService's ResetToDefaults contract.
        int baseXp = e.Kind switch
        {
            LostSpawns.Services.EntityKind.Wolf   => 15,
            LostSpawns.Services.EntityKind.Boar   => 10,
            LostSpawns.Services.EntityKind.Rabbit => 5,
            LostSpawns.Services.EntityKind.Crow   => 3,
            LostSpawns.Services.EntityKind.Deer   => 12,
            _ => 1,
        };

        // Combo multiplier: chained kills within the window escalate reward.
        // Streak 1 = 1x, 2 = 1.5x, 3 = 2x, 5+ = 3x. Feedback toast at 2+.
        var now = DateTime.UtcNow;
        if (now <= _killStreakExpiry) _killStreak++; else _killStreak = 1;
        _killStreakExpiry = now.AddSeconds(KillStreakWindow);
        float mul = _killStreak switch
        {
            <= 1 => 1f,
            2 => 1.5f,
            3 => 2f,
            4 => 2.5f,
            _ => 3f,
        };
        int xp = (int)MathF.Ceiling(baseXp * mul);
        if (_killStreak >= 2)
        {
            Hud.NotifySuccess($"{_killStreak}x COMBO! +{xp} XP");
            Audio.PlayLevelUp();
        }
        Stats.AwardXp(xp);
        Stats.RecordKill();
        Stats.RecordKindKill(e.Kind.ToString());
        if (e.Kind == LostSpawns.Services.EntityKind.Wolf)
        {
            Stats.TryAwardAchievement("First Wolf");
            // Pack Hunter: drop 5 wolves in one night. Counter resets at dawn
            // via the _wasNight latch in OnGameUpdate. Night-only increments
            // so a dusk/daytime cleanup doesn't count toward it.
            if (Time.IsNight)
            {
                _wolvesKilledThisNight++;
                if (_wolvesKilledThisNight >= 5)
                    Stats.TryAwardAchievement("Pack Hunter");
            }
        }
        if (e.Kind == LostSpawns.Services.EntityKind.Deer)
            Stats.TryAwardAchievement("Hunter");

        var drop = LootForEntityKind(e.Kind);
        if (drop is null) { Hud.Notify($"Killed {e.Kind} (+{xp} XP)"); return; }

        // Loot now lands on the ground at the entity's death position -
        // walking over it auto-picks it up (see GroundItemService.Tick).
        // Makes kills visually meaningful + keeps loot out of inventory
        // when it's already full, so nothing's silently lost.
        Ground.Drop(e.Position, drop);
        Hud.Notify($"Killed {e.Kind} (+{xp} XP) - drop on the ground");
    }

    private void HandleEntityHitAudio(LostSpawns.Services.WanderingEntity e)
    {
        // Per-kind reaction sound on non-fatal hits. Kill flow still plays
        // PlayHit from the attack handler; this layer adds vocal character:
        // wolves snarl when bitten-back, crows caw, others use the default.
        switch (e.Kind)
        {
            case LostSpawns.Services.EntityKind.Wolf: Audio.PlayWolfSnarl(); break;
            case LostSpawns.Services.EntityKind.Crow: Audio.PlayCrowCaw();  break;
        }
        // Blood splatter particles at the chest anchor (matches damage
        // number + billboard offsets). Purely cosmetic - reads as a "solid
        // hit landed" cue.
        Hud.ShowBloodSplatter(new System.Numerics.Vector3(
            e.Position.X, e.Position.Y + 0.8f, e.Position.Z));
    }

    private readonly Random _hitShakeRng = new();
    private void HandleEntityContactAttack(LostSpawns.Services.WanderingEntity e, float damage)
    {
        Stats.TakeDamage(damage);
        Hud.NotifyDamage($"{e.Kind} hit you!");
        Audio.PlayDamage();
        // Hit shake: small random yaw + pitch nudge scaled by damage. Reads
        // as the bite "jarring" the player. Mouse-look snaps back on the
        // next frame so the shake is a one-frame impact not lingering input
        // lag. Clamped below Camera's own ranges to stay sane.
        float yawShake = (float)(_hitShakeRng.NextDouble() - 0.5) * 6f * damage * 10f;
        float pitchShake = (float)(_hitShakeRng.NextDouble() - 0.5) * 4f * damage * 10f;
        Renderer.Camera.Yaw += yawShake;
        Renderer.Camera.Pitch = Math.Clamp(Renderer.Camera.Pitch + pitchShake, -89f, 89f);
        // Wolves have toothy bite -> bleed DoT. 6s base lets the player escape
        // and bandage in time without trivializing the encounter. Boar tusks
        // bleed a smaller window because gore-then-flee is the boar pattern.
        // Toast only when the bleed wasn't already active so we don't spam
        // every frame of pack contact damage.
        bool wasBleeding = Stats.BleedSecondsRemaining > 0;
        if (e.Kind == LostSpawns.Services.EntityKind.Wolf) Stats.ApplyBleed(6f);
        else if (e.Kind == LostSpawns.Services.EntityKind.Boar) Stats.ApplyBleed(3f);
        if (!wasBleeding && Stats.BleedSecondsRemaining > 0)
            Hud.NotifyWarning("Bleeding! Apply a bandage");
    }

