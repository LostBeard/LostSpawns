    private void HandleItemConsumedSound(string name, string verb, LostSpawns.Services.ItemEffect effect)
    {
        Audio.PlayConsume();
        // Bandages stop bleeding. Painkillers also clear it (they treat the
        // wound, not just the pain). Match by name since the inventory event
        // doesn't carry the item Id.
        if (name == "Bandage" || name == "Painkiller")
        {
            // Distinct fabric-rip audio whether or not there was an active
            // bleed - the player just used a bandage and that's the sound
            // a bandage makes.
            Audio.PlayBandageRip();
            if (Stats.BleedSecondsRemaining > 0)
            {
                Stats.ClearBleed();
                Hud.NotifySuccess("Bleeding stopped");
                // First Aid achievement: only fires when this consume actually
                // ended an active bleed, not on a cosmetic heal.
                Stats.TryAwardAchievement("First Aid");
            }
        }
        // Hot meals reduce active bleed by 1s - the warm food helps the
        // body close the wound. Doesn't fully clear bleed (that's
        // bandage/painkiller's job) but nibbling cooked meat through a
        // fight is now meaningful triage.
        else if (name.EndsWith(" (Cooked)") && Stats.BleedSecondsRemaining > 0)
        {
            Stats.ReduceBleed(1.0f);
        }
    }

    // Queued thunder delays. Each lightning strike pushes a random 0.5-2.0s
    // delay onto this list; OnGameUpdate decrements them and fires the
    // PlayThunder call on the frame the timer hits zero. Real-world
    // thunder lags the bolt because sound travels slower than light.
    private readonly System.Collections.Generic.List<float> _thunderQueue = new();
    private readonly Random _thunderRng = new();

    private void HandleLightningSound()
    {
        // Schedule the thunder rumble to land 0.5-2.0s after the visual
        // flash so close strikes "boom" almost immediately and far ones
        // have an unsettling delay.
        _thunderQueue.Add(0.5f + (float)_thunderRng.NextDouble() * 1.5f);
        // Storms drain fuel off every fire - the lightning itself doesn't
        // strike each fire, but the gust + rain that comes with it takes
        // a bite out of exposed wood. 10% per strike.
        foreach (var f in Fires.Fires)
            f.Fuel = MathF.Max(0f, f.Fuel - 0.10f);
    }

    private void TickThunderQueue(float dt)
    {
        for (int i = _thunderQueue.Count - 1; i >= 0; i--)
        {
            float t = _thunderQueue[i] - dt;
            if (t <= 0f)
            {
                Audio.PlayThunder();
                // Camera shake on the thunder boom - lightning that's close
                // enough to land within ~0.6s feels tactile, distant rumbles
                // barely register. Random small yaw/pitch nudge mirrors the
                // hit-shake pattern. Mouse-look re-centers on next input frame.
                float shake = (float)(_hitShakeRng.NextDouble() - 0.5) * 1.5f;
                Renderer.Camera.Yaw += shake;
                Renderer.Camera.Pitch = Math.Clamp(Renderer.Camera.Pitch + shake * 0.7f, -89f, 89f);
                _thunderQueue.RemoveAt(i);
            }
            else
            {
                _thunderQueue[i] = t;
            }
        }
    }

    private void HandleFeedFire()
    {
        if (Hud.IsAnyMenuOpen) return;

        // Feed fire takes precedence when one's in range AND the player is
        // holding fuel. Falls through to drink-water when there's no fire
        // to feed, so F is one key for "do a useful context action here".
        if (Fires.FindNearest(Renderer.Camera.Position) is not null)
        {
            if (Fires.TryFeedNearest(Renderer.Camera.Position, Inventory, out var reason))
            {
                // Post-feed fuel % so the player can see the fire's new
                // state at a glance. Uses the nearest fire right after
                // feed since TryFeedNearest mutates it in place.
                var near = Fires.FindNearest(Renderer.Camera.Position);
                int pct = near is null ? 100 : (int)(near.Fuel * 100);
                Hud.NotifySuccess($"Fed the fire ({pct}%)");
            }
            else if (!string.IsNullOrEmpty(reason))
                Hud.NotifyWarning(reason);
            return;
        }

        // Drink water: raycast the camera forward. If the hit is on a Water
        // block, restore thirst + toast. Range matches block-break so any
        // water you could fill-a-bucket at is also drinkable.
        var hit = World.Raycast(Renderer.Camera.Position, Renderer.Camera.Front, 5f);
        if (hit.DidHit && (LostSpawns.Models.BlockType)hit.BlockType == LostSpawns.Models.BlockType.Water)
        {
            if (Stats.Thirst >= 0.999f)
            {
                Hud.Notify("Not thirsty");
                return;
            }
            Stats.Thirst = Math.Min(1f, Stats.Thirst + 0.30f);
            // Small HP bump alongside the thirst restore - hydration actively
            // helps recovery, not just staves off dehydration damage.
            Stats.Heal(0.03f);
            // Cool effect: matches the consume.water Warmth field so drinking
            // from a lake and drinking from a bottle feel the same.
            Stats.Temperature = Stats.Temperature - 0.03f;
            Hud.NotifySuccess("Drank water");
            return;
        }

        Hud.NotifyWarning("Nothing to interact with");
    }

