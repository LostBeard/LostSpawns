    private void HandleDayAdvanced(int day)
    {
        // Day-advance reward: each survived night grants 5 XP per day
        // number reached, so sticking around past day 7 keeps progression
        // ticking even after the kill-spike plateaus.
        int dayBonus = 5 * day;
        Stats.AwardXp(dayBonus);
        Hud.Notify($"Day {day} - survived (+{dayBonus} XP)");
        // Storm escalation: each day past day 3 leans the next storm
        // heavier and shortens dry phases. Caps at 1.0 (Day 13+).
        // Maps Day 4 -> 0.1, Day 8 -> 0.5, Day 13 -> 1.0.
        Weather.StormBias = MathF.Min(1f, Math.Max(0, (day - 3)) * 0.1f);
        // Milestone toasts at survival landmarks for psychological reward.
        // Each one fires once (OnDayAdvanced is per-day so no latch needed).
        switch (day)
        {
            case 5:  Hud.NotifyAchievement("5 days. The wilderness knows you."); break;
            case 10: Hud.NotifyAchievement("10 days. Few make it this far."); break;
            case 14: Hud.NotifyAchievement("Two weeks. You're an expert now."); break;
            case 21: Hud.NotifyAchievement("Three weeks. A legend in these woods."); break;
            case 30: Hud.NotifyAchievement("30 days. The forest is yours."); break;
        }
        if (day >= 7) Stats.TryAwardAchievement("Survivor");
        // Celebratory dawn flash: warm golden wash fades over 1.2s to mark
        // "you survived another night". Softer than the damage flash so it
        // reads as reward not shock.
        Hud.ScreenOverlay.Flash(
            System.Drawing.Color.FromArgb(120, 255, 210, 140), 1.2f);
        Audio.PlayBirdChirp();
    }

