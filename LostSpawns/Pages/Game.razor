        if (amount >= 0.04f) Audio.PlayHeal();
    }

    private void HandleEntitySpawned(LostSpawns.Services.WanderingEntity e)
    {
        // Wolf arrival is meant to feel ominous - the howl announces them
        // before the red eyes are close enough to spot. Bears get an even
        // heavier roar since they're the rare apex spawn. Other kinds
        // spawn silently so the world doesn't chirp every 45 seconds.
        if (e.Kind == LostSpawns.Services.EntityKind.Wolf)
            Audio.PlayWolfHowl();
        else if (e.Kind == LostSpawns.Services.EntityKind.Bear)
        {
            Audio.PlayBearRoar();
            Hud.NotifyWarning("A bear has appeared!");
        }
